def monitor_quadrants() -> dict[str, tuple[str, Rect]]:
    with mss.MSS() as capture:
        monitors = list(capture.monitors[1:])
    result: dict[str, tuple[str, Rect]] = {}
    for monitor_number, monitor in enumerate(monitors, 1):
        left, top = int(monitor["left"]), int(monitor["top"])
        width, height = int(monitor["width"]), int(monitor["height"])
        half_w, half_h = width // 2, height // 2
        cells = (
            (left, top, half_w, half_h),
            (left + half_w, top, width - half_w, half_h),
            (left, top + half_h, half_w, height - half_h),
            (left + half_w, top + half_h, width - half_w, height - half_h),
        )
        for quadrant, values in enumerate(cells, 1):
            key = f"m{monitor_number}q{quadrant}"
            result[key] = (
                f"모니터 {monitor_number} / {quadrant}분면",
                Rect(*values),
            )
    return result


def center_on_parent(
    window: tk.Toplevel,
    parent: tk.Misc,
    width: int,
    height: int,
) -> None:
    parent.update_idletasks()
    x = parent.winfo_rootx() + (parent.winfo_width() - width) // 2
    y = parent.winfo_rooty() + (parent.winfo_height() - height) // 2
    window.geometry(f"{width}x{height}+{x}+{y}")


def center_on_cursor_monitor(
    window: tk.Misc,
    width: int,
    height: int,
) -> None:
    """마우스가 있는 모니터의 중앙에 창을 배치합니다."""
    cursor_x, cursor_y = cursor_position()
    with mss.MSS() as capture:
        monitors = list(capture.monitors[1:])
    monitor = next(
        (
            item
            for item in monitors
            if item["left"] <= cursor_x < item["left"] + item["width"]
            and item["top"] <= cursor_y < item["top"] + item["height"]
        ),
        monitors[0],
    )
    x = int(monitor["left"] + (monitor["width"] - width) // 2)
    y = int(monitor["top"] + (monitor["height"] - height) // 2)
    window.geometry(f"{width}x{height}+{x}+{y}")


class MacroEngine:
    def __init__(self, app: "MacroManager") -> None:
        self.app = app
        self.stop_event = threading.Event()
        self.thread: threading.Thread | None = None
        self.step_indexes: dict[str, int] = {}
        self.deadlines: dict[str, float] = {}
        self.step_started_at: dict[str, float] = {}
        self.entry_stages: dict[str, str] = {}
        self.entry_deadlines: dict[str, float] = {}
        self.pre_death_stages: dict[str, str] = {}
        # 물약 10개 감지 후 모래시계를 일정 시간 기다리기 위한 deadline입니다.
        self.pre_death_deadlines: dict[str, float] = {}
        self.return_deadlines: dict[str, float] = {}
        # 분면별 전체 루틴 시작 시각. 5분 recovery에 사용합니다.
        self.routine_started_at: dict[str, float] = {}
        # 한 분면에서 루틴을 시작하면 마지막 단계까지 다른 분면의
        # 클릭 루틴이 끼어들지 못하도록 현재 작업 대상을 잠급니다.
        self.active_target_key: str | None = None
        self.template_cache: dict[str, tuple[float, np.ndarray]] = {}

    def start(self) -> None:
        if self.thread and self.thread.is_alive():
            return
        self.stop_event.clear()
        self.thread = threading.Thread(target=self.loop, daemon=True)
        self.thread.start()

    def stop(self) -> None:
        self.stop_event.set()

    def reset_target(self, key: str) -> None:
        """루틴 선택이 바뀐 분면을 새 루틴의 첫 단계부터 다시 시작합니다."""
        self.step_indexes.pop(key, None)
        self.deadlines.pop(key, None)
        self.step_started_at.pop(key, None)
        self.entry_stages.pop(key, None)
        self.entry_deadlines.pop(key, None)
        self.pre_death_stages.pop(key, None)
        self.pre_death_deadlines.pop(key, None)
        self.return_deadlines.pop(key, None)
        self.routine_started_at.pop(key, None)

    def mark_routine_started(self, key: str) -> None:
        if key not in self.routine_started_at:
            self.routine_started_at[key] = time.monotonic()
            logging.info("%s 전체 루틴 5분 recovery 타이머 시작", key)

    def clear_routine_started(self, key: str) -> None:
        self.routine_started_at.pop(key, None)

    def recover_routine_position(
        self,
        gray: np.ndarray,
        rect: Rect,
        steps: list[dict],
        routine_overrides: dict,
    ) -> tuple[int, str, float] | None:
        detected: list[tuple[int, str, float]] = []

        for candidate_index, candidate in enumerate(steps):
            coordinate_only = (
                candidate.get("fallback") is not None
                or bool(candidate.get("coordinate_from_target"))
            )
            if coordinate_only:
                continue

            candidate_id = candidate.get("id", "")
            candidate_path = (
                routine_overrides.get(candidate_id)
                or candidate.get("image", "")
            )
            if not candidate_path:
                continue

            candidate_match = self.find(gray, candidate_path, rect)
            if candidate_match is None:
                continue

            detected.append(
                (
                    candidate_index,
                    candidate.get("name", candidate_id),
                    float(candidate_match[2]),
                )
            )

        if not detected:
            return None

        return max(detected, key=lambda item: item[0])

    def template(self, path: str) -> np.ndarray | None:
        if not path:
            return None
        file = Path(path)
        if not file.is_absolute():
            file = BASE_DIR / file
        if not file.exists():
            return None
        modified = file.stat().st_mtime
        cached = self.template_cache.get(str(file))
        if cached and cached[0] == modified:
            return cached[1]
        image = cv2.imdecode(np.fromfile(str(file), dtype=np.uint8), cv2.IMREAD_GRAYSCALE)
        if image is not None:
            self.template_cache[str(file)] = (modified, image)
        return image

    def find(self, screen: np.ndarray, path: str, rect: Rect) -> tuple[int, int, float] | None:
        template = self.template(path)
        if template is None:
            return None
        th, tw = template.shape[:2]
        if th > screen.shape[0] or tw > screen.shape[1]:
            return None
        result = cv2.matchTemplate(screen, template, cv2.TM_CCOEFF_NORMED)
        _, score, _, location = cv2.minMaxLoc(result)
        if score < float(self.app.config.get("threshold", DEFAULT_THRESHOLD)):
            return None
        return rect.left + location[0] + tw // 2, rect.top + location[1] + th // 2, float(score)

    def confirm_after_delay(
        self,
        capture: mss.MSS,
        rect: Rect,
        image_path: str,
        delay: float,
    ) -> tuple[int, int, float] | None:
        """클릭 직전에 새 화면에서 이미지를 다시 확인합니다."""
        time.sleep(max(0.0, delay))
        fresh_frame = np.asarray(capture.grab(rect.as_mss()))
        fresh_gray = cv2.cvtColor(fresh_frame, cv2.COLOR_BGRA2GRAY)
        return self.find(fresh_gray, image_path, rect)


    def advance(self, key: str, step_count: int, amount: int = 1) -> None:
        next_index = (
            self.step_indexes.get(key, 0) + amount
        ) % step_count
        self.step_indexes[key] = next_index
        self.deadlines.pop(key, None)
        self.step_started_at.pop(key, None)
        if next_index == 0:
            logging.info("%s 루틴 완료", key)
            self.clear_routine_started(key)

    def loop(self) -> None:
        try:
            with mss.MSS() as capture:
                while not self.stop_event.is_set():
                    config = self.app.config_snapshot()
                    if not config.get("post_routines"):
                        time.sleep(0.5)
                        continue
                    for key, (label, rect) in self.app.targets.items():
                        if self.stop_event.is_set():
                            break
                        # 분면별 step/deadline 상태를 독립적으로 진행합니다.
                        target = config.get("targets", {}).get(key, {})
                        if not target.get("enabled", False):
                            continue
                        steps = steps_for_target(config, target)
                        if not steps:
                            continue
                        routine_id = target.get(
                            "post_routine_id",
                            "default_hunting",
                        )
                        routine_overrides, routine_fallbacks = (
                            target_step_settings(target, routine_id)
                        )
                        index = self.step_indexes.get(key, 0) % len(steps)
                        step = steps[index]
                        step_id = step["id"]
                        override = routine_overrides.get(step_id) or ""
                        image_path = override or step.get("image", "")
                        step_uses_coordinate = (
                            step.get("fallback") is not None
                            or bool(step.get("coordinate_from_target"))
                        )

                        # fallback 좌표는 이미지 단계에서도 사용할 수 있습니다.
                        # 이미지 단계:
                        #   이미지 탐색 -> timeout -> fallback 좌표 클릭
                        # 좌표 전용 단계:
                        #   기존처럼 이미지를 사용하지 않고 fallback 좌표 사용
                        fallback = routine_fallbacks.get(step_id)
                        if fallback is None:
                            fallback = step.get("fallback")

                        if step_uses_coordinate:
                            image_path = ""

                        # 이동할 월드: 분면 전용/공용 이미지가 모두 없으면 즉시 다음 단계.
                        if step.get("skip_if_no_image") and not image_path and not step_uses_coordinate:
                            self.app.set_row_status(
                                key,
                                f"{index + 1}. {step['name']} 이미지 없음 → 다음 단계",
                            )
                            self.advance(key, len(steps))
                            continue

                        now = time.monotonic()
                        started_at = self.step_started_at.setdefault(key, now)
                        delay_before = float(step.get("delay_before", 0.0))
                        if now < started_at + delay_before:
                            remaining = started_at + delay_before - now
                            self.app.set_row_status(
                                key,
                                f"{index + 1}. {step['name']} 전 대기 {remaining:.1f}초",
                            )
                            continue
                        deadline = self.deadlines.setdefault(
                            key,
                            time.monotonic() + float(step.get("timeout", 10.0)),
                        )
                        try:
                            frame = np.asarray(capture.grab(rect.as_mss()))
                            gray = cv2.cvtColor(frame, cv2.COLOR_BGRA2GRAY)

                            routine_started = self.routine_started_at.get(key)
                            if routine_started is not None:
                                elapsed = time.monotonic() - routine_started
                                if elapsed >= ROUTINE_RECOVERY_SECONDS:
                                    self.app.set_row_status(key, "5분 초과 → 전체 루틴 이미지 재검색")
                                    recovery = self.recover_routine_position(gray, rect, steps, routine_overrides)
                                    if recovery is not None:
                                        recovered_index, recovered_name, recovered_score = recovery
                                        self.entry_stages.pop(key, None)
                                        self.entry_deadlines.pop(key, None)
                                        self.pre_death_stages.pop(key, None)
                                        self.pre_death_deadlines.pop(key, None)
                                        self.return_deadlines.pop(key, None)
                                        self.deadlines.pop(key, None)
                                        self.step_started_at.pop(key, None)
                                        self.step_indexes[key] = recovered_index
                                        self.routine_started_at[key] = time.monotonic()
                                        logging.warning(
                                            "%s 5분 초과 → %d. %s 감지(%.3f) → 해당 단계부터 재개",
                                            key, recovered_index + 1, recovered_name, recovered_score,
                                        )
                                        self.app.set_row_status(
                                            key,
                                            f"5분 복구 → {recovered_index + 1}. {recovered_name} 감지 → 해당 단계부터 재개",
                                        )
                                        continue
                                    logging.warning(
                                        "%s 5분 초과 → 전체 루틴 이미지 미검출 → 초기화", key,
                                    )
                                    self.reset_target(key)
                                    self.app.set_row_status(
                                        key,
                                        "5분 복구 실패 → 감지 이미지 없음 → 처음부터 다시 감시",
                                    )
                                    continue
                            match = None

                            pre_death_steps = {
                                item["id"]: item
                                for item in config.get("pre_death_steps", [])
                            }
                            entry_steps = {
                                item["id"]: item
                                for item in config.get("entry_steps", [])
                            }
                            pre_death_stage = self.pre_death_stages.get(key)
                            if pre_death_stage == "sandtimer_wait":
                                sandtimer = entry_steps.get("002_sandtimer")
                                if not sandtimer:
                                    self.pre_death_stages[key] = "home_icon"
                                    self.pre_death_deadlines.pop(key, None)
                                    self.app.set_row_status(
                                        key,
                                        "모래시계 설정 없음 → 집 아이콘 대기",
                                    )
                                    continue

                                sandtimer_override = (
                                    target.get("overrides", {}).get(
                                        "002_sandtimer"
                                    )
                                    or ""
                                )
                                sandtimer_path = (
                                    sandtimer_override
                                    or sandtimer.get("image", "")
                                )
                                sandtimer_match = self.find(
                                    gray,
                                    sandtimer_path,
                                    rect,
                                ) if sandtimer_path else None

                                if sandtimer_match:
                                    time.sleep(
                                        float(
                                            sandtimer.get(
                                                "pre_click_delay",
                                                PRE_CLICK_DELAY,
                                            )
                                        )
                                    )
                                    click_x, click_y = sandtimer_match[0], sandtimer_match[1]
                                    held_left_click(click_x, click_y)
                                    self.pre_death_stages[key] = "back_button"
                                    self.pre_death_deadlines.pop(key, None)
                                    self.app.set_row_status(
                                        key,
                                        f"사망 전 모래시계 클릭 {click_x},{click_y} → 뒤로가기 대기",
                                    )
                                    continue

                                if time.monotonic() >= self.pre_death_deadlines.get(
                                    key,
                                    0.0,
                                ):
                                    self.pre_death_stages[key] = "home_icon"
                                    self.pre_death_deadlines.pop(key, None)
                                    self.app.set_row_status(
                                        key,
                                        "사망 전 모래시계 미감지(timeout) → 뒤로가기 생략 → 집 아이콘 대기",
                                    )
                                    continue

                                remaining = max(
                                    0.0,
                                    self.pre_death_deadlines.get(key, 0.0)
                                    - time.monotonic(),
                                )
                                self.app.set_row_status(
                                    key,
                                    f"사망 전 모래시계 대기 {remaining:.1f}초",
                                )
                                continue

                            if pre_death_stage == "return_wait":
                                remaining = self.return_deadlines.get(key, 0.0) - time.monotonic()
                                if remaining > 0:
                                    self.app.set_row_status(
                                        key,
                                        f"집 이동 후 대기 {remaining:.1f}초",
                                    )
                                    continue
                                self.pre_death_stages.pop(key, None)
                                self.return_deadlines.pop(key, None)
                                menu_index = next(
                                    (
                                        i
                                        for i, candidate in enumerate(steps)
                                        if candidate.get("id") == "02_menu"
                                    ),
                                    1 if len(steps) > 1 else 0,
                                )
                                self.step_indexes[key] = menu_index
                                self.deadlines.pop(key, None)
                                self.step_started_at.pop(key, None)
                                self.app.set_row_status(
                                    key,
                                    "사망 전 귀환 완료 → 02 메뉴부터 시작",
                                )
                                continue

                            if pre_death_stage in ("back_button", "home_icon"):
                                action_step = pre_death_steps.get(pre_death_stage)
                                if not action_step:
                                    self.pre_death_stages.pop(key, None)
                                    continue
                                action_override = (
                                    target.get("overrides", {}).get(
                                        pre_death_stage
                                    )
                                    or ""
                                )
                                action_path = (
                                    action_override
                                    or action_step.get("image", "")
                                )
                                action_match = self.find(
                                    gray,
                                    action_path,
                                    rect,
                                ) if action_path else None
                                if action_match:
                                    time.sleep(
                                        float(
                                            action_step.get(
                                                "pre_click_delay",
                                                PRE_CLICK_DELAY,
                                            )
                                        )
                                    )
                                    click_x, click_y = action_match[0], action_match[1]
                                    held_left_click(click_x, click_y)
                                    if pre_death_stage == "back_button":
                                        self.pre_death_stages[key] = "home_icon"
                                        self.app.set_row_status(
                                            key,
                                            f"뒤로가기 클릭 {click_x},{click_y} → 집 아이콘 대기",
                                        )
                                    else:
                                        wait_seconds = float(
                                            config.get(
                                                "return_wait_seconds",
                                                20.0,
                                            )
                                        )
                                        self.pre_death_stages[key] = "return_wait"
                                        self.return_deadlines[key] = (
                                            time.monotonic() + wait_seconds
                                        )
                                        self.app.set_row_status(
                                            key,
                                            f"집 아이콘 클릭 {click_x},{click_y} → {wait_seconds:g}초 대기",
                                        )
                                else:
                                    self.app.set_row_status(
                                        key,
                                        f"{action_step['name']} 이미지 대기",
                                    )
                                continue

                            # 기본 루틴의 첫 단계(01_revive)를 기다리는 동안에는
                            # 001_dyied도 함께 감시합니다. 001이 먼저 발견되면
                            # 001 → 002를 처리한 뒤 다시 01부터 시작합니다.
                            if index == 0:
                                entry_steps = {
                                    item["id"]: item
                                    for item in config.get("entry_steps", [])
                                }
                                entry_stage = self.entry_stages.get(key)
                                if entry_stage == "002_sandtimer":
                                    sandtimer = entry_steps.get("002_sandtimer")
                                    if sandtimer:
                                        sandtimer_override = (
                                            target.get("overrides", {}).get(
                                                "002_sandtimer"
                                            )
                                            or ""
                                        )
                                        sandtimer_path = (
                                            sandtimer_override
                                            or sandtimer.get("image", "")
                                        )
                                        sandtimer_match = self.find(
                                            gray,
                                            sandtimer_path,
                                            rect,
                                        )
                                        # 002를 놓쳤더라도 01이 이미 표시됐다면
                                        # 즉시 기본 루틴으로 합류합니다.
                                        revive_match = self.find(
                                            gray,
                                            image_path,
                                            rect,
                                        ) if image_path else None
                                        if sandtimer_match:
                                            time.sleep(
                                                float(
                                                    sandtimer.get(
                                                        "pre_click_delay",
                                                        PRE_CLICK_DELAY,
                                                    )
                                                )
                                            )
                                            held_left_click(
                                                sandtimer_match[0],
                                                sandtimer_match[1],
                                            )
                                            self.entry_stages.pop(key, None)
                                            self.entry_deadlines.pop(key, None)
                                            self.app.set_row_status(
                                                key,
                                                "진입 002 모래시계 클릭 → 01 대기",
                                            )
                                            continue
                                        if revive_match:
                                            self.entry_stages.pop(key, None)
                                            self.entry_deadlines.pop(key, None)
                                            match = revive_match
                                        elif time.monotonic() >= self.entry_deadlines.get(
                                            key,
                                            0.0,
                                        ):
                                            self.entry_stages.pop(key, None)
                                            self.entry_deadlines.pop(key, None)
                                            self.app.set_row_status(
                                                key,
                                                "002 시간 초과 → 01 대기",
                                            )
                                            continue
                                        else:
                                            self.app.set_row_status(
                                                key,
                                                "진입 002 모래시계 대기",
                                            )
                                            continue
                                elif entry_stage is None:
                                    dyied = entry_steps.get("001_dyied")
                                    if dyied:
                                        dyied_override = (
                                            target.get("overrides", {}).get(
                                                "001_dyied"
                                            )
                                            or ""
                                        )
                                        dyied_path = (
                                            dyied_override
                                            or dyied.get("image", "")
                                        )
                                        dyied_match = self.find(
                                            gray,
                                            dyied_path,
                                            rect,
                                        )
                                        if dyied_match:
                                            self.mark_routine_started(key)
                                            logging.info("%s 사망 진입 루틴 시작", key)
                                            time.sleep(
                                                float(
                                                    dyied.get(
                                                        "pre_click_delay",
                                                        PRE_CLICK_DELAY,
                                                    )
                                                )
                                            )
                                            held_left_click(
                                                dyied_match[0],
                                                dyied_match[1],
                                            )
                                            sandtimer = entry_steps.get(
                                                "002_sandtimer",
                                                {},
                                            )
                                            self.entry_stages[key] = (
                                                "002_sandtimer"
                                            )
                                            self.entry_deadlines[key] = (
                                                time.monotonic()
                                                + float(
                                                    sandtimer.get(
                                                        "timeout",
                                                        15.0,
                                                    )
                                                )
                                            )
                                            self.app.set_row_status(
                                                key,
                                                "진입 001 사망 화면 클릭 → 002 대기",
                                            )
                                            continue

                            if match is None:
                                match = self.find(
                                    gray,
                                    image_path,
                                    rect,
                                ) if image_path else None

                            # 사망/부활 화면이 아닌 정상 사냥 화면에서 물약 10개
                            # 이미지를 발견하면 사망 전 귀환 루틴을 시작합니다.
                            if index == 0 and match is None:
                                potion_step = pre_death_steps.get("potion_10")
                                if potion_step:
                                    potion_override = (
                                        target.get("overrides", {}).get(
                                            "potion_10"
                                        )
                                        or ""
                                    )
                                    potion_path = (
                                        potion_override
                                        or potion_step.get("image", "")
                                    )
                                    potion_match = self.find(
                                        gray,
                                        potion_path,
                                        rect,
                                    ) if potion_path else None
                                    if potion_match:
                                        self.mark_routine_started(key)
                                        logging.info("%s 사망 전 귀환 루틴 시작", key)
                                        sandtimer = entry_steps.get(
                                            "002_sandtimer",
                                            {},
                                        )
                                        timeout = max(
                                            0.0,
                                            float(
                                                sandtimer.get(
                                                    "timeout",
                                                    3.0,
                                                )
                                            ),
                                        )
                                        self.pre_death_stages[key] = "sandtimer_wait"
                                        self.pre_death_deadlines[key] = (
                                            time.monotonic() + timeout
                                        )
                                        self.app.set_row_status(
                                            key,
                                            f"물약 10개 감지 → 사망 전 모래시계 {timeout:g}초 대기",
                                        )
                                        continue
                            if match:
                                confirmed_match = self.confirm_after_delay(
                                    capture,
                                    rect,
                                    image_path,
                                    float(
                                        step.get(
                                            "pre_click_delay",
                                            PRE_CLICK_DELAY,
                                        )
                                    ),
                                )
                                if confirmed_match is None:
                                    self.app.set_row_status(
                                        key,
                                        f"{index + 1}. {step['name']} 재확인 실패 → 클릭 취소",
                                    )
                                    continue
                                if index == 0:
                                    self.mark_routine_started(key)
                                logging.info("%s 루틴 진행 시작", key)
                                click_x, click_y = confirmed_match[0], confirmed_match[1]
                                if step_id == "17_monster":
                                    click_x += 10
                                held_left_click(click_x, click_y)
                                self.app.set_row_status(
                                    key,
                                    f"{index + 1}. {step['name']} 클릭 {click_x},{click_y} ({confirmed_match[2]:.3f})",
                                )
                                time.sleep(
                                    max(
                                        0.0,
                                        float(
                                            step.get(
                                                "after_click_delay",
                                                0.0,
                                            )
                                        ),
                                    )
                                )
                                self.advance(key, len(steps))
                            elif time.monotonic() >= deadline:
                                if fallback and len(fallback) == 2:
                                    x, y = rect.left + int(fallback[0]), rect.top + int(fallback[1])
                                    time.sleep(
                                        float(
                                            step.get(
                                                "pre_click_delay",
                                                PRE_CLICK_DELAY,
                                            )
                                        )
                                    )
                                    held_left_click(x, y)
                                    self.app.set_row_status(
                                        key, f"{index + 1}. 미검출 → 좌표 클릭"
                                    )
                                    self.advance(key, len(steps))
                                elif step.get("on_timeout") == "click_current":
                                    time.sleep(
                                        float(
                                            step.get(
                                                "pre_click_delay",
                                                PRE_CLICK_DELAY,
                                            )
                                        )
                                    )
                                    held_left_click()
                                    self.app.set_row_status(
                                        key,
                                        f"{index + 1}. 미검출 → 현재 위치 클릭",
                                    )
                                    self.advance(key, len(steps))
                                elif step.get("on_timeout") == "skip":
                                    skip_count = max(1, int(step.get("skip_count", 1)))
                                    self.app.set_row_status(
                                        key,
                                        f"{index + 1}. 미검출 → {skip_count}단계 이동",
                                    )
                                    self.advance(key, len(steps), skip_count)
                                else:
                                    self.app.set_row_status(
                                        key, f"{index + 1}. 이미지 대기 (fallback 없음)"
                                    )
                                    self.deadlines[key] = time.monotonic() + float(
                                        step.get("timeout", 10.0)
                                    )
                        except Exception as exc:
                            logging.exception("%s 감시 오류", label)
                            self.app.set_row_status(key, f"오류: {exc}")
                    time.sleep(SCAN_INTERVAL)
        except Exception as exc:
            logging.exception("감시 엔진 종료")
            self.app.set_global_status(f"감시 엔진 오류: {exc}")




# Tkinter UI는 macro_manager_ui.py로 분리했습니다.

def main() -> None:
    from macro_manager_ui import MacroManager
    enable_dpi_awareness()
    logging.basicConfig(
        filename=LOG_FILE,
        level=logging.INFO,
        encoding="utf-8",
        format="%(asctime)s | %(levelname)s | %(message)s",
    )
    MacroManager().run()


if __name__ == "__main__":
    try:
        if instance_is_running():
            show_already_running()
        elif ensure_admin():
            hide_console()
            if not acquire_single_instance():
                show_already_running()
            else:
                try:
                    main()
                finally:
                    release_single_instance()
    except Exception as error:
        logging.exception("프로그램 오류: %s", error)
