    def dungeon_status_db_path(self) -> Path:
        return BASE_DIR / "dungeon_status.db"

    def read_today_status(self, target_key: str, dungeon: str) -> str:
        db_path = self.dungeon_status_db_path()
        if not db_path.exists():
            return "이용가능"

        try:
            today = time.strftime("%Y-%m-%d")
            with sqlite3.connect(db_path) as conn:
                row = conn.execute(
                    "SELECT status FROM dungeon_usage "
                    "WHERE target_key = ? AND dungeon = ? AND usage_date = ?",
                    (target_key, dungeon, today),
                ).fetchone()

            if row and str(row[0]).upper() == "COMPLETED":
                return "만료"
            return "이용가능"
        except Exception:
            logging.exception(
                "던전 상태 DB 읽기 실패: target=%s dungeon=%s",
                target_key,
                dungeon,
            )
            return "확인 실패"

    def refresh_statuses(self) -> None:
        for target_key, dungeon_vars in self.status_vars.items():
            for dungeon in ("A", "B"):
                dungeon_vars[dungeon].set(
                    self.read_today_status(target_key, dungeon)
                )

    def save(self) -> None:
        dungeon_cfg = self.app.config.setdefault("dungeon_daily", {})
        target_cfg = dungeon_cfg.setdefault("targets", {})

        for target_key, dungeon_vars in self.vars.items():
            saved = target_cfg.setdefault(target_key, {})
            saved["A"] = bool(dungeon_vars["A"].get())
            saved["B"] = bool(dungeon_vars["B"].get())

        self.app.persist()
        self.app.global_status.set("매일 던전 설정 저장 완료")
        self.destroy()

