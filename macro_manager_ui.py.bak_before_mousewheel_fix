_UI_POLISHED_WINDOWS: set[int] = set()
_UI_WHEEL_INSTALLED = False


def _safe_configure(widget, **kwargs) -> None:
    try:
        widget.configure(**kwargs)
    except Exception:
        pass


def _is_scrollable(widget) -> bool:
    return hasattr(widget, "yview_scroll") or hasattr(widget, "xview_scroll")


def _scroll_target_from_pointer(root):
    try:
        x, y = root.winfo_pointerxy()
        widget = root.winfo_containing(x, y)
    except Exception:
        return None

    current = widget
    while current is not None:
        if _is_scrollable(current):
            return current
        current = getattr(current, "master", None)
    return None


def _on_mousewheel(root, event):
    target = _scroll_target_from_pointer(root)
    if target is None:
        return

    delta = getattr(event, "delta", 0)
    if delta == 0:
        return

    units = -int(delta / 120)
    if units == 0:
        units = -1 if delta > 0 else 1

    try:
        if event.state & 0x0001 and hasattr(target, "xview_scroll"):
            target.xview_scroll(units, "units")
        elif hasattr(target, "yview_scroll"):
            target.yview_scroll(units, "units")
        return "break"
    except Exception:
        return None


def _on_linux_wheel(root, direction, event):
    target = _scroll_target_from_pointer(root)
    if target is None:
        return

    try:
        if event.state & 0x0001 and hasattr(target, "xview_scroll"):
            target.xview_scroll(direction, "units")
        elif hasattr(target, "yview_scroll"):
            target.yview_scroll(direction, "units")
        return "break"
    except Exception:
        return None


def install_global_mousewheel(root) -> None:
    global _UI_WHEEL_INSTALLED
    if _UI_WHEEL_INSTALLED:
        return
    _UI_WHEEL_INSTALLED = True

    try:
        root.bind_all(
            "<MouseWheel>",
            lambda e, r=root: _on_mousewheel(r, e),
            add="+",
        )
        root.bind_all(
            "<Shift-MouseWheel>",
            lambda e, r=root: _on_mousewheel(r, e),
            add="+",
        )
        root.bind_all(
            "<Button-4>",
            lambda e, r=root: _on_linux_wheel(r, -1, e),
            add="+",
        )
        root.bind_all(
            "<Button-5>",
            lambda e, r=root: _on_linux_wheel(r, 1, e),
            add="+",
        )
    except Exception:
        pass


def _apply_widget_design(widget) -> None:
    try:
        cls = widget.winfo_class()
    except Exception:
        cls = ""

    if cls == "Treeview":
        try:
            widget.configure(style="Editor.Treeview", selectmode="browse")
        except Exception:
            pass

    elif cls == "TButton":
        try:
            text = str(widget.cget("text")).strip()
        except Exception:
            text = ""

        if text in {"저장", "적용", "확인", "추가", "만들기"}:
            _safe_configure(widget, style="Primary.TButton")
        elif "삭제" in text:
            _safe_configure(widget, style="Danger.TButton")
        else:
            _safe_configure(widget, style="Secondary.TButton")

    elif cls == "TEntry":
        try:
            width = int(widget.cget("width"))
            if width > 70:
                widget.configure(width=46)
        except Exception:
            pass

    elif cls == "Listbox":
        try:
            widget.configure(
                exportselection=False,
                activestyle="none",
                borderwidth=0,
                highlightthickness=1,
            )
        except Exception:
            pass

    try:
        children = widget.winfo_children()
    except Exception:
        children = []

    for child in children:
        _apply_widget_design(child)


def _polish_editor_window(window) -> None:
    try:
        wid = int(window.winfo_id())
    except Exception:
        return

    if wid in _UI_POLISHED_WINDOWS:
        return
    _UI_POLISHED_WINDOWS.add(wid)

    try:
        title = window.title()
    except Exception:
        title = ""

    is_target_editor = "분면" in title
    is_routine_editor = "루틴" in title or "Routine" in title

    if isinstance(window, tk.Toplevel):
        try:
            if is_target_editor or is_routine_editor:
                window.geometry("1180x760")
                window.minsize(1000, 680)
            else:
                window.minsize(860, 600)
            window.resizable(True, True)
        except Exception:
            pass

        try:
            window.bind("<Escape>", lambda _e, w=window: w.destroy(), add="+")
        except Exception:
            pass

        if callable(getattr(window, "save", None)):
            try:
                window.bind(
                    "<Control-s>",
                    lambda _e, w=window: (w.save(), "break")[-1],
                    add="+",
                )
            except Exception:
                pass

    _apply_widget_design(window)


def _poll_windows(root) -> None:
    try:
        stack = [root]
        while stack:
            widget = stack.pop()
            try:
                children = widget.winfo_children()
            except Exception:
                children = []

            for child in children:
                if isinstance(child, tk.Toplevel):
                    _polish_editor_window(child)
                stack.append(child)

        root.after(250, lambda: _poll_windows(root))
    except Exception:
        pass


def apply_unified_ui(root) -> None:
    def _apply():
        try:
            style = ttk.Style(root)
            themes = set(style.theme_names())

            if sys.platform.startswith("win") and "vista" in themes:
                style.theme_use("vista")
            elif "clam" in themes:
                style.theme_use("clam")

            root.option_add("*Font", ("Segoe UI", 10))
            root.option_add("*TCombobox*Listbox.font", ("Segoe UI", 10))

            style.configure("TLabel", padding=(0, 2))
            style.configure("TEntry", padding=5)
            style.configure("TCombobox", padding=4)
            style.configure("TCheckbutton", padding=(2, 4))
            style.configure("TRadiobutton", padding=(2, 4))

            style.configure(
                "Primary.TButton",
                padding=(14, 8),
                font=("Segoe UI Semibold", 10),
            )
            style.configure(
                "Secondary.TButton",
                padding=(11, 7),
            )
            style.configure(
                "Danger.TButton",
                padding=(11, 7),
                font=("Segoe UI Semibold", 10),
            )

            style.configure("TLabelframe", padding=12)
            style.configure(
                "TLabelframe.Label",
                font=("Segoe UI Semibold", 10),
            )

            style.configure(
                "Treeview",
                rowheight=30,
                font=("Segoe UI", 10),
                borderwidth=0,
            )
            style.configure(
                "Treeview.Heading",
                font=("Segoe UI Semibold", 10),
                padding=(8, 7),
            )
            style.configure(
                "Editor.Treeview",
                rowheight=32,
                font=("Segoe UI", 10),
            )

            style.configure(
                "TNotebook.Tab",
                padding=(16, 8),
                font=("Segoe UI Semibold", 10),
            )

            try:
                root.minsize(920, 640)
            except Exception:
                pass

            install_global_mousewheel(root)
            _apply_widget_design(root)
            _poll_windows(root)

        except Exception:
            try:
                root.after(50, _apply)
            except Exception:
                pass

    _apply()


class CropDialog(tk.Toplevel):
    def __init__(self, parent: tk.Misc, image: np.ndarray) -> None:
        super().__init__(parent)
        self.title("캡처 영역 선택")
        self.transient(parent)
        self.result: tuple[int, int, int, int] | None = None
        self.start_point: tuple[int, int] | None = None
        self.rectangle: int | None = None
        original_height, original_width = image.shape[:2]
        self.scale = min(1.0, 1400 / original_width, 760 / original_height)
        display_width = max(1, round(original_width * self.scale))
        display_height = max(1, round(original_height * self.scale))
        if self.scale < 1.0:
            display = cv2.resize(
                image,
                (display_width, display_height),
                interpolation=cv2.INTER_AREA,
            )
        else:
            display = image

        success, encoded = cv2.imencode(".png", display)
        if not success:
            raise RuntimeError("캡처 미리보기 생성 실패")
        png_data = base64.b64encode(encoded.tobytes()).decode("ascii")
        self.photo = tk.PhotoImage(data=png_data)

        ttk.Label(
            self,
            text="저장할 부분을 마우스로 드래그하세요.  Esc 또는 취소를 누르면 닫힙니다.",
            font=("Malgun Gothic", 11),
            padding=8,
        ).pack(fill="x")
        self.canvas = tk.Canvas(
            self,
            width=display_width,
            height=display_height,
            cursor="crosshair",
            highlightthickness=0,
        )
        self.canvas.pack(padx=10)
        self.canvas.create_image(0, 0, image=self.photo, anchor="nw")
        self.canvas.bind("<ButtonPress-1>", self.begin_selection)
        self.canvas.bind("<B1-Motion>", self.update_selection)
        self.canvas.bind("<ButtonRelease-1>", self.update_selection)

        buttons = ttk.Frame(self, padding=10)
        buttons.pack(fill="x")
        ttk.Button(buttons, text="선택 저장", command=self.confirm).pack(
            side="right", padx=4
        )
        ttk.Button(buttons, text="취소", command=self.cancel).pack(
            side="right", padx=4
        )
        self.bind("<Return>", lambda _event: self.confirm())
        self.bind("<Escape>", lambda _event: self.cancel())
        self.protocol("WM_DELETE_WINDOW", self.cancel)
        self.resizable(False, False)
        self.update_idletasks()
        center_on_parent(
            self,
            parent,
            self.winfo_reqwidth(),
            self.winfo_reqheight(),
        )
        self.grab_set()
        self.focus_force()

    def bounded_point(self, event: tk.Event) -> tuple[int, int]:
        x = max(0, min(int(event.x), int(self.canvas["width"])))
        y = max(0, min(int(event.y), int(self.canvas["height"])))
        return x, y

    def begin_selection(self, event: tk.Event) -> None:
        self.start_point = self.bounded_point(event)
        if self.rectangle is not None:
            self.canvas.delete(self.rectangle)
        x, y = self.start_point
        self.rectangle = self.canvas.create_rectangle(
            x,
            y,
            x,
            y,
            outline="#00a2ff",
            width=3,
        )

    def update_selection(self, event: tk.Event) -> None:
        if self.start_point is None or self.rectangle is None:
            return
        x, y = self.bounded_point(event)
        self.canvas.coords(
            self.rectangle,
            self.start_point[0],
            self.start_point[1],
            x,
            y,
        )

    def confirm(self) -> None:
        if self.rectangle is None:
            messagebox.showinfo(
                "영역 선택",
                "저장할 부분을 먼저 드래그하세요.",
                parent=self,
            )
            return
        x1, y1, x2, y2 = self.canvas.coords(self.rectangle)
        left, right = sorted((x1, x2))
        top, bottom = sorted((y1, y2))
        if right - left < 2 or bottom - top < 2:
            messagebox.showinfo(
                "영역 선택",
                "조금 더 큰 영역을 선택하세요.",
                parent=self,
            )
            return
        self.result = (
            round(left / self.scale),
            round(top / self.scale),
            round((right - left) / self.scale),
            round((bottom - top) / self.scale),
        )
        self.grab_release()
        self.destroy()

    def cancel(self) -> None:
        self.result = None
        try:
            self.grab_release()
        except tk.TclError:
            pass
        self.destroy()


class TargetEditor(tk.Toplevel):
    """분면별 루틴 선택 + 루틴 생성/삭제 + 단계 편집을 한 화면에서 처리합니다."""

    DEFAULT_ROUTINE_ID = "default_hunting"

    def __init__(self, app: "MacroManager", key: str) -> None:
        super().__init__(app.root)
        self.app = app
        self.key = key
        self.title(f"분면별 루틴 설정 - {app.targets[key][0]}")
        self.transient(app.root)
        self.minsize(1500, 760)
        center_on_parent(self, app.root, 1850, 920)

        self.rows: list[dict] = []
        self.current_routine_id: str | None = None
        self.routine_name_to_id: dict[str, str] = {}

        target = self.app.config["targets"].setdefault(self.key, {})
        current_id = target.get("post_routine_id", self.DEFAULT_ROUTINE_ID)

        header = ttk.Frame(self, padding=(14, 12, 14, 8))
        header.pack(fill="x")

        ttk.Label(
            header,
            text=f"대상: {self.app.targets[self.key][0]}",
            font=("Segoe UI Semibold", 12),
        ).pack(side="left", padx=(0, 18))

        ttk.Label(header, text="적용 루틴").pack(side="left")

        self.routine_var = tk.StringVar()
        self.routine_combo = ttk.Combobox(
            header,
            textvariable=self.routine_var,
            state="readonly",
            width=24,
        )
        self.routine_combo.pack(side="left", padx=(6, 8))
        self.routine_combo.bind("<<ComboboxSelected>>", self.change_routine)

        ttk.Button(
            header,
            text="루틴 만들기",
            command=self.open_create_routine_dialog,
        ).pack(side="left", padx=3)

        self.delete_routine_button = ttk.Button(
            header,
            text="루틴 삭제",
            command=self.delete_current_routine,
        )
        self.delete_routine_button.pack(side="left", padx=3)

        ttk.Label(
            header,
            text="기본 루틴은 단계 구조가 잠겨 있으며 이미지/좌표와 클릭 전 대기만 변경할 수 있습니다.",
        ).pack(side="left", padx=(16, 0))

        outer = ttk.Frame(self, padding=(10, 4, 10, 4))
        outer.pack(fill="both", expand=True)

        self.canvas = tk.Canvas(outer, highlightthickness=0)
        ybar = ttk.Scrollbar(outer, orient="vertical", command=self.canvas.yview)
        xbar = ttk.Scrollbar(outer, orient="horizontal", command=self.canvas.xview)

        self.body = ttk.Frame(self.canvas)
        self.body.bind(
            "<Configure>",
            lambda _event: self.canvas.configure(
                scrollregion=self.canvas.bbox("all")
            ),
        )

        self.canvas.create_window((0, 0), window=self.body, anchor="nw")
        self.canvas.configure(
            yscrollcommand=ybar.set,
            xscrollcommand=xbar.set,
        )

        self.canvas.grid(row=0, column=0, sticky="nsew")
        ybar.grid(row=0, column=1, sticky="ns")
        xbar.grid(row=1, column=0, sticky="ew")
        outer.rowconfigure(0, weight=1)
        outer.columnconfigure(0, weight=1)

        footer = ttk.Frame(self, padding=(12, 8, 12, 12))
        footer.pack(fill="x")

        self.info_var = tk.StringVar(value="")
        ttk.Label(
            footer,
            textvariable=self.info_var,
        ).pack(side="left")

        ttk.Button(
            footer,
            text="닫기",
            command=self.destroy,
            width=14,
        ).pack(side="right", padx=(6, 0))

        ttk.Button(
            footer,
            text="저장",
            style="Primary.TButton",
            command=self.save,
            width=14,
        ).pack(side="right")

        self.refresh_routine_choices(current_id)

    def refresh_routine_choices(self, select_id: str | None = None) -> None:
        routines = self.app.config.setdefault("post_routines", {})
        self.routine_name_to_id = {}

        names: list[str] = []
        selected_name = ""

        for routine_id, routine in routines.items():
            name = routine.get("name", routine_id)
            display = (
                f"{name} (기본)"
                if routine_id == self.DEFAULT_ROUTINE_ID
                else name
            )

            if display in self.routine_name_to_id:
                display = f"{display} [{routine_id}]"

            self.routine_name_to_id[display] = routine_id
            names.append(display)

            if routine_id == select_id:
                selected_name = display

        self.routine_combo.configure(values=names)

        if not selected_name and names:
            selected_name = names[0]

        if selected_name:
            self.routine_var.set(selected_name)
            self.current_routine_id = self.routine_name_to_id[selected_name]
        else:
            self.routine_var.set("")
            self.current_routine_id = None

        self.refresh_delete_button()
        self.build_rows()

    def selected_routine_id(self) -> str | None:
        return self.routine_name_to_id.get(self.routine_var.get())

    def change_routine(self, _event: tk.Event | None = None) -> None:
        if self.current_routine_id:
            if not self.save_rows(persist=False):
                return

        routine_id = self.selected_routine_id()
        if not routine_id:
            return

        self.current_routine_id = routine_id
        target = self.app.config["targets"].setdefault(self.key, {})
        target["post_routine_id"] = routine_id
        self.app.persist()
        self.app.engine.reset_target(self.key)
        self.app.refresh_main_routine_choices()

        self.refresh_delete_button()
        self.build_rows()

    def refresh_delete_button(self) -> None:
        state = (
            "disabled"
            if self.current_routine_id == self.DEFAULT_ROUTINE_ID
            else "normal"
        )
        self.delete_routine_button.configure(state=state)

    def open_create_routine_dialog(self) -> None:
        if self.current_routine_id:
            if not self.save_rows(persist=False):
                return

        dialog = tk.Toplevel(self)
        dialog.title("새 루틴 만들기")
        dialog.transient(self)
        dialog.resizable(False, False)
        center_on_parent(dialog, self, 520, 250)

        frame = ttk.Frame(dialog, padding=18)
        frame.pack(fill="both", expand=True)

        ttk.Label(
            frame,
            text="새 루틴 만들기",
            font=("Segoe UI Semibold", 13),
        ).grid(row=0, column=0, columnspan=2, sticky="w", pady=(0, 14))

        routines = self.app.config.setdefault("post_routines", {})
        base_name_to_id: dict[str, str] = {}
        base_names: list[str] = []

        for routine_id, routine in routines.items():
            display = routine.get("name", routine_id)
            if routine_id == self.DEFAULT_ROUTINE_ID:
                display = f"{display} (기본)"
            if display in base_name_to_id:
                display = f"{display} [{routine_id}]"
            base_name_to_id[display] = routine_id
            base_names.append(display)

        default_base = next(
            (
                name
                for name, routine_id in base_name_to_id.items()
                if routine_id == self.current_routine_id
            ),
            next(iter(base_names), ""),
        )

        base_var = tk.StringVar(value=default_base)
        name_var = tk.StringVar(value="새 루틴")

        ttk.Label(frame, text="베이스가 될 루틴").grid(
            row=1, column=0, sticky="w", padx=(0, 12), pady=6
        )
        ttk.Combobox(
            frame,
            textvariable=base_var,
            values=base_names,
            state="readonly",
            width=34,
        ).grid(row=1, column=1, sticky="ew", pady=6)

        ttk.Label(frame, text="만들 루틴명").grid(
            row=2, column=0, sticky="w", padx=(0, 12), pady=6
        )
        name_entry = ttk.Entry(
            frame,
            textvariable=name_var,
            width=36,
        )
        name_entry.grid(row=2, column=1, sticky="ew", pady=6)

        button_row = ttk.Frame(frame)
        button_row.grid(
            row=3,
            column=0,
            columnspan=2,
            sticky="e",
            pady=(18, 0),
        )

        def create() -> None:
            name = name_var.get().strip()
            base_id = base_name_to_id.get(base_var.get())

            if not name:
                messagebox.showerror(
                    "루틴명 필요",
                    "만들 루틴명을 입력하세요.",
                    parent=dialog,
                )
                return

            if not base_id or base_id not in routines:
                messagebox.showerror(
                    "베이스 루틴 오류",
                    "베이스가 될 루틴을 선택하세요.",
                    parent=dialog,
                )
                return

            existing_names = {
                routine.get("name", routine_id)
                for routine_id, routine in routines.items()
            }
            if name in existing_names:
                messagebox.showerror(
                    "루틴명 중복",
                    "같은 이름의 루틴이 이미 있습니다.",
                    parent=dialog,
                )
                return

            routine_id = f"routine_{time.time_ns()}"
            source = routines[base_id]
            routines[routine_id] = {
                "name": name,
                "steps": json.loads(
                    json.dumps(source.get("steps", []))
                ),
            }

            target = self.app.config["targets"].setdefault(self.key, {})
            target["post_routine_id"] = routine_id

            initialize_routine_target_settings(self.app.config)
            self.app.persist()
            self.app.engine.reset_target(self.key)
            self.app.refresh_main_routine_choices()

            dialog.destroy()
            self.refresh_routine_choices(routine_id)
            self.info_var.set(f"'{name}' 루틴을 만들었습니다.")

        ttk.Button(
            button_row,
            text="취소",
            command=dialog.destroy,
            width=12,
        ).pack(side="right", padx=(6, 0))

        ttk.Button(
            button_row,
            text="만들기",
            style="Primary.TButton",
            command=create,
            width=12,
        ).pack(side="right")

        dialog.bind("<Return>", lambda _e: create())
        dialog.bind("<Escape>", lambda _e: dialog.destroy())
        dialog.grab_set()
        name_entry.focus_set()
        name_entry.select_range(0, "end")

    def delete_current_routine(self) -> None:
        routine_id = self.current_routine_id
        if not routine_id:
            return

        if routine_id == self.DEFAULT_ROUTINE_ID:
            messagebox.showinfo(
                "삭제 불가",
                "기본 루틴은 삭제할 수 없습니다.",
                parent=self,
            )
            return

        routine = self.app.config["post_routines"].get(routine_id)
        if not routine:
            return

        routine_name = routine.get("name", routine_id)

        if not messagebox.askyesno(
            "루틴 삭제",
            f"'{routine_name}' 루틴을 정말 삭제하시겠습니까?",
            parent=self,
        ):
            return

        del self.app.config["post_routines"][routine_id]

        for target in self.app.config.get("targets", {}).values():
            if target.get("post_routine_id") == routine_id:
                target["post_routine_id"] = self.DEFAULT_ROUTINE_ID

            routine_settings = target.get("routine_settings")
            if isinstance(routine_settings, dict):
                routine_settings.pop(routine_id, None)

        initialize_routine_target_settings(self.app.config)
        self.app.persist()
        self.app.engine.reset_target(self.key)
        self.app.refresh_main_routine_choices()

        self.refresh_routine_choices(self.DEFAULT_ROUTINE_ID)
        self.info_var.set(f"'{routine_name}' 루틴을 삭제했습니다.")

    def build_rows(self, focus_step_id: str | None = None) -> None:
