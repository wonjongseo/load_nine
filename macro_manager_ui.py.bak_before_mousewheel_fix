    def routine_names(self) -> list[str]:
        return [
            routine.get("name", routine_id)
            for routine_id, routine in self.config.get("post_routines", {}).items()
        ]

    def change_target_routine(self, key: str) -> None:
        selected_name = self.routine_vars[key].get()
        routine_id = next(
            (
                rid
                for rid, routine in self.config.get("post_routines", {}).items()
                if routine.get("name", rid) == selected_name
            ),
            None,
        )
        if not routine_id:
            return
        self.config["targets"].setdefault(key, {})["post_routine_id"] = routine_id
        self.persist()
        self.engine.reset_target(key)
        self.status_vars[key].set(f"루틴 변경: {selected_name} → 첫 단계 대기")

    def refresh_main_routine_choices(self) -> None:
        names = self.routine_names()
        for key, combo in self.routine_combos.items():
            combo.configure(values=names)
            target = self.config.get("targets", {}).get(key, {})
            routine_id = target.get("post_routine_id", "default_hunting")
            routine = self.config.get("post_routines", {}).get(routine_id)
            if routine is None and self.config.get("post_routines"):
                routine_id, routine = next(iter(self.config["post_routines"].items()))
                target["post_routine_id"] = routine_id
            self.routine_vars[key].set(
                (routine or {}).get("name", "")
            )

    def open_routine_manager(self) -> None:
        manager = EditableRoutineManager(self)
        self.root.wait_window(manager)
        self.refresh_main_routine_choices()

    def open_dungeon_settings(self) -> None:
        DungeonSettingsWindow(self)

    def config_snapshot(self) -> dict:
        with self.config_lock:
            return json.loads(json.dumps(self.config))

    def persist(self) -> None:
        with self.config_lock:
            save_config(self.config)
        self.global_status.set(f"설정 저장 완료: {CONFIG_FILE.name}")

    def save_threshold(self) -> None:
        try:
            value = float(self.threshold_var.get())
            if not 0 < value <= 1:
                raise ValueError
            return_wait = float(self.return_wait_var.get())
            if return_wait < 0:
                raise ValueError
            self.config["threshold"] = value
            self.config["return_wait_seconds"] = return_wait
            self.persist()
        except ValueError:
            messagebox.showerror(
                "입력 오류",
                "인식 기준은 0 초과 1 이하, 귀환 대기는 0 이상의 숫자여야 합니다.",
            )

    def toggle_target(self, key: str) -> None:
        self.config["targets"].setdefault(key, {})["enabled"] = self.enabled_vars[key].get()
        self.persist()

