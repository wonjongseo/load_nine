    def selected_list_id(self) -> str | None:
        selected = self.routine_list.curselection()
        if not selected:
            return None
        return self.routine_ids[selected[0]]

    def refresh_routine_list(self, select_id: str | None = None) -> None:
        self.routine_list.delete(0, "end")
        self.routine_ids = []
        for routine_id, routine in self.working_routines.items():
            self.routine_ids.append(routine_id)
            prefix = "[기본 템플릿] " if routine_id == "default_hunting" else ""
            self.routine_list.insert("end", prefix + routine.get("name", routine_id))
        if self.routine_ids:
            target_id = select_id if select_id in self.routine_ids else self.routine_ids[0]
            index = self.routine_ids.index(target_id)
            self.routine_list.selection_set(index)
            self.routine_list.activate(index)
            self.current_routine_id = target_id
            self.build_rows()

    def change_routine(self, _event: tk.Event | None = None) -> None:
        new_id = self.selected_list_id()
        if not new_id or new_id == self.current_routine_id:
            return
        if self.current_routine_id:
            if not self.save_rows(show_message=False):
                return
        self.current_routine_id = new_id
        self.build_rows()

    def build_rows(self, focus_step_id: str | None = None) -> None:
        for child in self.body.winfo_children():
            child.destroy()
        self.rows = []
        routine = self.working_routines.get(self.current_routine_id or "", {})
        self.routine_title_var.set(routine.get("name", ""))
        headers = (
            "순서", "단계 이름", "동작", "공용 이미지 또는 좌표 X,Y",
            "제한시간", "클릭 전 대기", "행 작업",
        )
        for column, title in enumerate(headers):
            ttk.Label(self.body, text=title, font=("Malgun Gothic", 10, "bold")).grid(
                row=0, column=column, padx=3, pady=6
            )
        self.body.columnconfigure(1, weight=2)
        self.body.columnconfigure(3, weight=5)
        for index, step in enumerate(routine.get("steps", [])):
            fallback = step.get("fallback")
            target_coordinate = bool(step.get("coordinate_from_target"))
            name_var = tk.StringVar(value=step.get("name", ""))
            action_var = tk.StringVar(
                value="좌표 클릭"
                if fallback is not None or target_coordinate
                else "이미지 클릭"
            )
            value_var = tk.StringVar(value=step.get("image", ""))
            x_var = tk.StringVar(
                value=str(fallback[0]) if fallback is not None else ""
            )
            y_var = tk.StringVar(
                value=str(fallback[1]) if fallback is not None else ""
            )
            timeout_var = tk.StringVar(value=str(step.get("timeout", 15.0)))
            delay_var = tk.StringVar(value=str(step.get("pre_click_delay", PRE_CLICK_DELAY)))
            ttk.Label(self.body, text=str(index + 1), width=5, anchor="center").grid(row=index + 1, column=0)
            name_entry = ttk.Entry(self.body, textvariable=name_var, width=28)
            name_entry.grid(row=index + 1, column=1, sticky="ew", padx=3, pady=2)
            action_combo = ttk.Combobox(
                self.body,
                textvariable=action_var,
                values=("이미지 클릭", "좌표 클릭"),
                state="readonly",
                width=12,
            )
            action_combo.grid(row=index + 1, column=2, padx=3, pady=2)
            value_cell = ttk.Frame(self.body)
            value_cell.grid(row=index + 1, column=3, sticky="ew", padx=3, pady=2)
            image_entry = ttk.Entry(value_cell, textvariable=value_var, width=58)
            image_entry.bind(
                "<Button-1>",
                lambda event, v=value_var, a=action_var: self.click_image_entry(
                    event, v, a
                ),
            )
            coordinate_frame = ttk.Frame(value_cell)
            ttk.Label(coordinate_frame, text="X").pack(side="left", padx=(0, 3))
            ttk.Entry(coordinate_frame, textvariable=x_var, width=14).pack(side="left")
            ttk.Label(coordinate_frame, text="Y").pack(side="left", padx=(12, 3))
            ttk.Entry(coordinate_frame, textvariable=y_var, width=14).pack(side="left")
            button_refs: dict[str, ttk.Button] = {}

            def toggle_value_cell(
                *_args: object,
                action: tk.StringVar = action_var,
                image_widget: ttk.Entry = image_entry,
                coordinate_widget: ttk.Frame = coordinate_frame,
                buttons: dict[str, ttk.Button] = button_refs,
            ) -> None:
                image_widget.pack_forget()
                coordinate_widget.pack_forget()
                if action.get() == "좌표 클릭":
                    coordinate_widget.pack(fill="x")
                    buttons["file"].configure(state="disabled")
                    buttons["capture"].configure(state="disabled")
                else:
                    image_widget.pack(fill="x")
                    buttons["file"].configure(state="normal")
                    buttons["capture"].configure(state="normal")
            ttk.Entry(self.body, textvariable=timeout_var, width=9).grid(row=index + 1, column=4, padx=3)
            ttk.Entry(self.body, textvariable=delay_var, width=9).grid(row=index + 1, column=5, padx=3)
            actions = ttk.Frame(self.body)
            actions.grid(row=index + 1, column=6, padx=2)
            file_button = ttk.Button(actions, text="파일", width=5, command=lambda v=value_var, a=action_var: self.choose_file(v, a))
            file_button.pack(side="left")
            capture_button = ttk.Button(
                actions,
                text="캡처",
                width=5,
                command=lambda v=value_var, a=action_var, sid=step.get("id", "step"), order=index + 1, n=name_var: self.capture_row(v, a, sid, order, n),
            )
            capture_button.pack(side="left")
            button_refs["file"] = file_button
            button_refs["capture"] = capture_button
            ttk.Button(actions, text="아래+", width=6, command=lambda i=index: self.add_below(i)).pack(side="left")
            ttk.Button(actions, text="삭제", width=5, command=lambda i=index: self.delete_row(i)).pack(side="left")
            ttk.Button(actions, text="↑", width=3, command=lambda i=index: self.move_row(i, -1)).pack(side="left")
            ttk.Button(actions, text="↓", width=3, command=lambda i=index: self.move_row(i, 1)).pack(side="left")
            action_var.trace_add("write", toggle_value_cell)
            toggle_value_cell()
            self.rows.append({
                "step": step, "name": name_var, "action": action_var,
                "value": value_var, "x": x_var, "y": y_var,
                "from_target": target_coordinate,
                "timeout": timeout_var, "delay": delay_var,
            })
            if focus_step_id == step.get("id"):
                self.after(10, name_entry.focus_set)

    def choose_file(self, value_var: tk.StringVar, action_var: tk.StringVar) -> None:
        path = filedialog.askopenfilename(parent=self, initialdir=BASE_DIR / "images", filetypes=[("이미지", "*.png *.jpg *.bmp")])
        if path:
            action_var.set("이미지 클릭")
            value_var.set(path)

    def click_image_entry(
        self,
        _event: tk.Event,
        value_var: tk.StringVar,
        action_var: tk.StringVar,
    ) -> str:
        self.choose_file(value_var, action_var)
        return "break"

    def capture_row(
        self,
        value_var: tk.StringVar,
        action_var: tk.StringVar,
        step_id: str,
        order: int,
        name_var: tk.StringVar,
    ) -> None:
        key = self.capture_label_to_key.get(self.capture_source_var.get())
        if not key:
            messagebox.showerror("캡처 화면 없음", "캡처할 모니터/분면을 선택하세요.", parent=self)
            return
        routine_dir = CAPTURE_DIR / "common_routines" / (
            self.current_routine_id or "default_hunting"
        )
        path = self.app.capture_and_crop(
            key,
            step_id,
            destination_dir=routine_dir,
            parent=self,
            suggested_filename=self.capture_filename(order, name_var.get()),
        )
        if path:
            action_var.set("이미지 클릭")
            value_var.set(path)

    @staticmethod
    def capture_filename(order: int, step_name: str) -> str:
        clean_name = re.sub(r'[<>:"/\\|?*]', "", step_name.strip())
        clean_name = re.sub(r"\s+", "_", clean_name).strip("._")
        if not clean_name:
            clean_name = f"{order:02d}_step"
        elif not re.match(r"^\d+", clean_name):
            clean_name = f"{order:02d}_{clean_name}"
        return f"{clean_name}.png"

    def save_rows(self, show_message: bool = True) -> bool:
        if not self.current_routine_id:
            return True
        try:
            for row in self.rows:
                step = row["step"]
                name = row["name"].get().strip()
                if not name:
                    raise ValueError("단계 이름은 비워둘 수 없습니다.")
                timeout = float(row["timeout"].get())
                delay = float(row["delay"].get())
                if timeout < 0 or delay < 0:
                    raise ValueError("제한시간과 클릭 전 대기는 0 이상이어야 합니다.")
                step["name"], step["timeout"], step["pre_click_delay"] = name, timeout, delay
                if row["action"].get() == "좌표 클릭":
                    x_text = row["x"].get().strip()
                    y_text = row["y"].get().strip()
                    if not x_text and not y_text and row.get("from_target"):
                        step.pop("fallback", None)
                        step["coordinate_from_target"] = True
                    else:
                        if not x_text or not y_text:
                            raise ValueError(f"'{name}'의 X와 Y 좌표를 모두 입력하세요.")
                        step["fallback"] = [int(x_text), int(y_text)]
                        step.pop("coordinate_from_target", None)
                    step["image"] = ""
                else:
                    step.pop("fallback", None)
                    step.pop("coordinate_from_target", None)
                    step["image"] = row["value"].get().strip()
        except ValueError as exc:
            messagebox.showerror("입력 오류", str(exc), parent=self)
            return False
        if show_message:
            self.app.config["post_routines"] = json.loads(
                json.dumps(self.working_routines)
            )
            initialize_routine_target_settings(self.app.config)
            existing_ids = set(self.working_routines)
            for target in self.app.config.get("targets", {}).values():
                if target.get("post_routine_id") not in existing_ids:
                    target["post_routine_id"] = "default_hunting"
            self.app.persist()
            self.routine_title_var.set(
                self.working_routines[self.current_routine_id]["name"]
                + " — 저장 완료"
            )
        return True

    def add_below(self, index: int) -> None:
        if not self.save_rows(show_message=False):
            return
        steps = self.working_routines[self.current_routine_id]["steps"]
        step = {"id": f"custom_{time.time_ns()}", "name": "새 단계", "image": "", "timeout": 15.0, "pre_click_delay": PRE_CLICK_DELAY}
        steps.insert(index + 1, step)
        self.build_rows(step["id"])

    def delete_row(self, index: int) -> None:
        if not self.save_rows(show_message=False):
            return
        del self.working_routines[self.current_routine_id]["steps"][index]
        self.build_rows()

    def move_row(self, index: int, offset: int) -> None:
        if not self.save_rows(show_message=False):
            return
        steps = self.working_routines[self.current_routine_id]["steps"]
        destination = max(0, min(len(steps) - 1, index + offset))
        if destination != index:
            step = steps.pop(index)
            steps.insert(destination, step)
            self.build_rows(step.get("id"))

    def new_routine(self) -> None:
        if self.current_routine_id and not self.save_rows(show_message=False):
            return
        name = simpledialog.askstring("새 전체 루틴", "새 루틴 이름:", initialvalue="새 전체 자동화 루틴", parent=self)
        if not name:
            return
        routine_id = f"routine_{time.time_ns()}"
        source = self.working_routines.get("default_hunting", {"steps": []})
        self.working_routines[routine_id] = {"name": name, "steps": json.loads(json.dumps(source.get("steps", [])))}
        self.refresh_routine_list(routine_id)

    def duplicate_routine(self) -> None:
        if self.current_routine_id and not self.save_rows(show_message=False):
            return
        source_id = self.selected_list_id()
        if not source_id:
            return
        source = self.working_routines[source_id]
        name = simpledialog.askstring("루틴 복제", "새 루틴 이름:", initialvalue=f"{source['name']} 복사본", parent=self)
        if not name:
            return
        routine_id = f"routine_{time.time_ns()}"
        self.working_routines[routine_id] = {"name": name, "steps": json.loads(json.dumps(source.get("steps", [])))}
        self.refresh_routine_list(routine_id)

    def rename_routine(self) -> None:
        if self.current_routine_id and not self.save_rows(show_message=False):
            return
        routine_id = self.selected_list_id()
        if not routine_id:
            return
        routine = self.working_routines[routine_id]
        name = simpledialog.askstring("루틴 이름 변경", "새 루틴 이름:", initialvalue=routine["name"], parent=self)
        if name:
            routine["name"] = name.strip()
            self.refresh_routine_list(routine_id)

    def delete_routine(self) -> None:
        if self.current_routine_id and not self.save_rows(show_message=False):
            return
        routine_id = self.selected_list_id() or self.current_routine_id
        if not routine_id or routine_id == "default_hunting":
            messagebox.showinfo("삭제 불가", "기본 전체 루틴은 삭제할 수 없습니다.", parent=self)
            return
        routine_name = self.working_routines[routine_id].get("name", routine_id)
        if not messagebox.askyesno(
            "루틴 삭제",
            f"'{routine_name}' 루틴을 삭제할까요?\n\n"
            "목록에서 삭제한 뒤 '변경 내용 저장'을 눌러야 최종 반영됩니다.",
            parent=self,
        ):
            return
        del self.working_routines[routine_id]
        self.current_routine_id = None
        self.refresh_routine_list("default_hunting")
        self.routine_title_var.set(
            f"{routine_name} 삭제 예정 — 변경 내용 저장을 눌러 최종 반영"
        )

    def close(self) -> None:
        self.destroy()



