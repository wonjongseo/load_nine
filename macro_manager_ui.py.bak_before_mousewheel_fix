    def choose_file(
        self,
        image_var: tk.StringVar,
        action_var: tk.StringVar,
    ) -> None:
        path = filedialog.askopenfilename(
            parent=self,
            initialdir=BASE_DIR / "images",
            filetypes=[
                ("이미지", "*.png *.jpg *.bmp"),
                ("모든 파일", "*.*"),
            ],
        )
        if path:
            image_var.set(path)
            if action_var.get() != "이미지 클릭":
                action_var.set("이미지 클릭")

    def capture_row(
        self,
        image_var: tk.StringVar,
        action_var: tk.StringVar,
        step: dict,
        order: int,
        name_var: tk.StringVar,
    ) -> None:
        step_id = step.get("id", f"step_{order}")
        routine_dir = CAPTURE_DIR / "common_routines" / (
            self.current_routine_id or self.DEFAULT_ROUTINE_ID
        )

        path = self.app.capture_and_crop(
            self.key,
            step_id,
            destination_dir=routine_dir,
            parent=self,
            suggested_filename=self.capture_filename(
                order,
                name_var.get(),
            ),
        )

        if path:
            image_var.set(path)
            if action_var.get() != "이미지 클릭":
                action_var.set("이미지 클릭")

    @staticmethod
    def capture_filename(order: int, step_name: str) -> str:
        clean_name = re.sub(
            r'[<>:"/\\|?*]',
            "",
            step_name.strip(),
        )
        clean_name = re.sub(
            r"\s+",
            "_",
            clean_name,
        ).strip("._")

        if not clean_name:
            clean_name = f"{order:02d}_step"
        elif not re.match(r"^\d+", clean_name):
            clean_name = f"{order:02d}_{clean_name}"

        return f"{clean_name}.png"

    def add_below(self, index: int) -> None:
        if self.current_routine_id == self.DEFAULT_ROUTINE_ID:
            return
        if not self.save_rows(persist=False):
            return

        routine = self.app.config["post_routines"][self.current_routine_id]
        new_step = {
            "id": f"custom_{time.time_ns()}",
            "name": "새 단계",
            "image": "",
            "timeout": 15.0,
            "pre_click_delay": PRE_CLICK_DELAY,
        }
        routine["steps"].insert(index + 1, new_step)
        self.app.persist()
        self.build_rows(new_step["id"])

    def delete_row(self, index: int) -> None:
        if self.current_routine_id == self.DEFAULT_ROUTINE_ID:
            return
        if not self.save_rows(persist=False):
            return

        routine = self.app.config["post_routines"][self.current_routine_id]
        step = routine["steps"][index]

        if not messagebox.askyesno(
            "단계 삭제",
            f"'{step.get('name', '선택 단계')}' 단계를 삭제하시겠습니까?",
            parent=self,
        ):
            return

        del routine["steps"][index]
        self.app.persist()
        self.build_rows()

    def move_row(self, index: int, offset: int) -> None:
        if self.current_routine_id == self.DEFAULT_ROUTINE_ID:
            return
        if not self.save_rows(persist=False):
            return

        steps = self.app.config["post_routines"][self.current_routine_id]["steps"]
        destination = max(
            0,
            min(len(steps) - 1, index + offset),
        )

        if destination == index:
            return

        step = steps.pop(index)
        steps.insert(destination, step)
        self.app.persist()
        self.build_rows(step.get("id"))

    def save_rows(self, persist: bool = True) -> bool:
        routine_id = self.current_routine_id
        if not routine_id:
            return True

        routine = self.app.config["post_routines"].get(routine_id)
        if not routine:
            return True

        is_default = routine_id == self.DEFAULT_ROUTINE_ID

        target = self.app.config["targets"].setdefault(self.key, {})
        routine_overrides, routine_fallbacks = target_step_settings(
            target,
            routine_id,
        )

        try:
            for row in self.rows:
                step = row["step"]

                if not is_default:
                    name = row["name"].get().strip()
                    if not name:
                        raise ValueError(
                            "단계 이름은 비워둘 수 없습니다."
                        )
                    step["name"] = name

                delay = float(row["delay"].get())
                if delay < 0:
                    raise ValueError(
                        "클릭 전 대기는 0 이상이어야 합니다."
                    )
                step["pre_click_delay"] = delay

                step_id = row["id"]
                action = row["action"].get()

                if action == "좌표 클릭":
                    x_text = row["x"].get().strip()
                    y_text = row["y"].get().strip()

                    if not x_text or not y_text:
                        raise ValueError(
                            f"'{step.get('name', '')}' 단계의 X와 Y 좌표를 모두 입력하세요."
                        )

                    routine_fallbacks[step_id] = [
                        int(float(x_text)),
                        int(float(y_text)),
                    ]

                    if not is_default:
                        step["coordinate_from_target"] = True
                        step.pop("fallback", None)

                    routine_overrides.pop(step_id, None)

                else:
                    image = row["image"].get().strip()
                    common_image = row.get("common_image", "")

                    if image and image != common_image:
                        routine_overrides[step_id] = image
                    else:
                        routine_overrides.pop(step_id, None)

                    if not is_default:
                        step.pop("coordinate_from_target", None)
                        step.pop("fallback", None)

                    # 이미지 단계의 기존 fallback 좌표는 보존합니다.

        except ValueError as exc:
            messagebox.showerror(
                "입력 오류",
                str(exc),
                parent=self,
            )
            return False

        if persist:
            target["post_routine_id"] = routine_id

            initialize_routine_target_settings(self.app.config)
            self.app.persist()
            self.app.engine.reset_target(self.key)
            self.app.refresh_main_routine_choices()
            self.info_var.set("저장 완료")

        return True

    def save(self) -> None:
        self.save_rows(persist=True)

