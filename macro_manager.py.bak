def load_config() -> dict:
    if not CONFIG_FILE.exists():
        data = default_config()
        migrate_post_routines(data)
        initialize_routine_target_settings(data)
        save_config(data)
        return data
    try:
        data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        data.setdefault("threshold", DEFAULT_THRESHOLD)
        data.setdefault("return_wait_seconds", 20.0)
        data.setdefault(
            "pre_death_steps",
            default_config()["pre_death_steps"],
        )
        data.setdefault("entry_steps", default_config()["entry_steps"])
        data.setdefault("steps", [])
        data.setdefault("targets", {})
        migrate_post_routines(data)
        initialize_routine_target_settings(data)
        save_config(data)
        return data
    except Exception as exc:
        logging.exception("설정 불러오기 실패")
        messagebox.showwarning("설정 오류", f"기본 설정으로 시작합니다.\n{exc}")
        return default_config()


def migrate_post_routines(config: dict) -> None:
    """기존 설정을 선택 가능한 01~21 전체 루틴 구조로 변환합니다."""
    if config.get("full_routines_v2"):
        migrate_default_hunting_v3(config)
        mark_target_coordinate_steps(config)
        for target in config.get("targets", {}).values():
            target.setdefault("post_routine_id", "default_hunting")
        return

    if "post_routines" not in config:
        all_steps = list(config.get("steps", []))
        config["post_routines"] = {
            "default_hunting": {
                "name": "기본 전체 루틴",
                "steps": all_steps,
            }
        }
    else:
        # 직전 버전은 01~14와 15~21을 분리해 저장했습니다. 모든 기존
        # 커스텀 루틴 앞에 01~14를 복사하여 전체 루틴으로 승격합니다.
        base_steps = list(config.get("steps", []))
        if base_steps:
            for routine in config["post_routines"].values():
                routine["steps"] = json.loads(json.dumps(base_steps)) + list(
                    routine.get("steps", [])
                )
        default = config["post_routines"].get("default_hunting")
        if default:
            default["name"] = "기본 전체 루틴"
    config["steps"] = []
    config["full_routines_v2"] = True
    migrate_default_hunting_v3(config)
    mark_target_coordinate_steps(config)
    for target in config.get("targets", {}).values():
        target.setdefault("post_routine_id", "default_hunting")


def migrate_default_hunting_v3(config: dict) -> None:
    # 기본 루틴: 15 월드맵 -> 16 이동할 월드 -> ... -> 22 AUTO
    # 기존 override 호환성을 위해 기존 내부 ID는 그대로 유지합니다.
    routines = config.get("post_routines", {})
    routine = routines.get("default_hunting")
    if not routine:
        return

    steps = routine.setdefault("steps", [])
    ids = [step.get("id") for step in steps]
    if "16_world" not in ids:
        insert_at = next((i + 1 for i, s in enumerate(steps) if s.get("id") == "15_world_map"), None)
        if insert_at is not None:
            steps.insert(insert_at, {
                "id": "16_world",
                "name": "16 이동할 월드",
                "image": "",
                "timeout": 5.0,
                "on_timeout": "skip",
                "skip_count": 1,
                "skip_if_no_image": True,
                "pre_click_delay": PRE_CLICK_DELAY,
            })

    renamed = {
        "16_region": "17 이동할 지역",
        "17_hunting_ground": "18 이동할 사냥터",
        "18_monster": "19 몬스터",
        "19_quick_move": "20 빠른 이동",
        "20_confirm": "21 빠른 이동 확인",
        "21_auto": "22 AUTO",
    }
    for step in steps:
        if step.get("id") in renamed:
            step["name"] = renamed[step["id"]]
    config["default_hunting_v3"] = True


def mark_target_coordinate_steps(config: dict) -> None:
    """공용 이미지 없이 분면별 좌표를 쓰는 단계를 좌표 동작으로 표시합니다."""
    for routine in config.get("post_routines", {}).values():
        for step in routine.get("steps", []):
            if (
                step.get("id") == "15_world_map"
                and not step.get("image")
                and step.get("fallback") is None
            ):
                step["coordinate_from_target"] = True


def steps_for_target(config: dict, target: dict) -> list[dict]:
    routines = config.get("post_routines", {})
    routine_id = target.get("post_routine_id", "default_hunting")
    routine = routines.get(routine_id)
    if routine is None and routines:
        routine = next(iter(routines.values()))
    return list((routine or {}).get("steps", []))


def initialize_routine_target_settings(config: dict) -> None:
    """커스텀 루틴별 분면 이미지/좌표를 기본 루틴과 분리합니다."""
    routines = config.get("post_routines", {})
    default_steps = {
        step.get("id"): step
        for step in routines.get("default_hunting", {}).get("steps", [])
    }
    for target in config.get("targets", {}).values():
        settings_by_routine = target.setdefault("routine_settings", {})
        legacy_overrides = target.get("overrides", {})
        legacy_fallbacks = target.get("fallbacks", {})
        for routine_id, routine in routines.items():
            if routine_id == "default_hunting" or routine_id in settings_by_routine:
                continue
            overrides: dict[str, str] = {}
            fallbacks: dict[str, list[int]] = {}
            for step in routine.get("steps", []):
                step_id = step.get("id")
                default = default_steps.get(step_id)
                if not default:
                    continue
                same_action = (
                    bool(step.get("coordinate_from_target"))
                    == bool(default.get("coordinate_from_target"))
                    and (step.get("fallback") is not None)
                    == (default.get("fallback") is not None)
                )
                same_image = step.get("image", "") == default.get("image", "")
                if same_action and same_image:
                    if step_id in legacy_overrides:
                        overrides[step_id] = legacy_overrides[step_id]
                    if step_id in legacy_fallbacks:
                        fallbacks[step_id] = legacy_fallbacks[step_id]
            settings_by_routine[routine_id] = {
                "overrides": overrides,
                "fallbacks": fallbacks,
                "click_offsets": {},
            }


def target_step_settings(target: dict, routine_id: str) -> tuple[dict, dict]:
    if routine_id == "default_hunting":
        return (
            target.setdefault("overrides", {}),
            target.setdefault("fallbacks", {}),
        )

    settings = target.setdefault("routine_settings", {}).setdefault(
        routine_id,
        {"overrides": {}, "fallbacks": {}, "click_offsets": {}},
    )

    return (
        settings.setdefault("overrides", {}),
        settings.setdefault("fallbacks", {}),
    )


def target_legacy_click_offsets(target: dict) -> dict:
    # 사망 전/사망 후 진입 단계의 분면별 클릭 보정값
    return target.setdefault("legacy_click_offsets", {})


def target_click_offsets(target: dict, routine_id: str) -> dict:
    if routine_id == "default_hunting":
        return target.setdefault("click_offsets", {})

    settings = target.setdefault("routine_settings", {}).setdefault(
        routine_id,
        {"overrides": {}, "fallbacks": {}, "click_offsets": {}},
    )

    return settings.setdefault("click_offsets", {})


def save_config(config: dict) -> None:
    CONFIG_FILE.write_text(
        json.dumps(config, ensure_ascii=False, indent=2), encoding="utf-8"
    )


def monitor_quadrants() -> dict[str, tuple[str, Rect]]:
    with mss.MSS() as capture:
        monitors = list(capture.monitors[1:])
    result: dict[str, tuple[str, Rect]] = {}
    for monitor_number, monitor in enumerate(monitors, 1):
        left, top = int(monitor["left"]), int(monitor["top"])
        width, height = int(monitor["width"]), int(monitor["height"])
        half_w, half_h = width // 2, height // 2
        cells = (
            (left, top, half_w, half_h),
            (left + half_w, top, width - half_w, half_h),
            (left, top + half_h, half_w, height - half_h),
            (left + half_w, top + half_h, width - half_w, height - half_h),
        )
        for quadrant, values in enumerate(cells, 1):
            key = f"m{monitor_number}q{quadrant}"
            result[key] = (
                f"모니터 {monitor_number} / {quadrant}분면",
                Rect(*values),
            )
    return result


def center_on_parent(
    window: tk.Toplevel,
    parent: tk.Misc,
    width: int,
    height: int,
) -> None:
    parent.update_idletasks()
    x = parent.winfo_rootx() + (parent.winfo_width() - width) // 2
    y = parent.winfo_rooty() + (parent.winfo_height() - height) // 2
    window.geometry(f"{width}x{height}+{x}+{y}")


def center_on_cursor_monitor(
    window: tk.Misc,
    width: int,
    height: int,
) -> None:
    """마우스가 있는 모니터의 중앙에 창을 배치합니다."""
    cursor_x, cursor_y = cursor_position()
    with mss.MSS() as capture:
        monitors = list(capture.monitors[1:])
    monitor = next(
        (
            item
            for item in monitors
            if item["left"] <= cursor_x < item["left"] + item["width"]
            and item["top"] <= cursor_y < item["top"] + item["height"]
        ),
        monitors[0],
    )
    x = int(monitor["left"] + (monitor["width"] - width) // 2)
    y = int(monitor["top"] + (monitor["height"] - height) // 2)
    window.geometry(f"{width}x{height}+{x}+{y}")


class MacroEngine:
    def __init__(self, app: "MacroManager") -> None:
        self.app = app
        self.stop_event = threading.Event()
        self.thread: threading.Thread | None = None
        self.step_indexes: dict[str, int] = {}
        self.deadlines: dict[str, float] = {}
        self.step_started_at: dict[str, float] = {}
        self.entry_stages: dict[str, str] = {}
        self.entry_deadlines: dict[str, float] = {}
        self.pre_death_stages: dict[str, str] = {}
        # 물약 10개 감지 후 모래시계를 일정 시간 기다리기 위한 deadline입니다.
        self.pre_death_deadlines: dict[str, float] = {}
        self.return_deadlines: dict[str, float] = {}
        # 한 분면에서 루틴을 시작하면 마지막 단계까지 다른 분면의
        # 클릭 루틴이 끼어들지 못하도록 현재 작업 대상을 잠급니다.
        self.active_target_key: str | None = None
        self.template_cache: dict[str, tuple[float, np.ndarray]] = {}

    def start(self) -> None:
        if self.thread and self.thread.is_alive():
            return
        self.stop_event.clear()
        self.thread = threading.Thread(target=self.loop, daemon=True)
        self.thread.start()

    def stop(self) -> None:
        self.stop_event.set()

    def reset_target(self, key: str) -> None:
        """루틴 선택이 바뀐 분면을 새 루틴의 첫 단계부터 다시 시작합니다."""
        self.step_indexes.pop(key, None)
        self.deadlines.pop(key, None)
        self.step_started_at.pop(key, None)
        self.entry_stages.pop(key, None)
        self.entry_deadlines.pop(key, None)
        self.pre_death_stages.pop(key, None)
        self.pre_death_deadlines.pop(key, None)
        self.return_deadlines.pop(key, None)

    def template(self, path: str) -> np.ndarray | None:
        if not path:
            return None
        file = Path(path)
        if not file.is_absolute():
            file = BASE_DIR / file
        if not file.exists():
            return None
        modified = file.stat().st_mtime
        cached = self.template_cache.get(str(file))
        if cached and cached[0] == modified:
            return cached[1]
        image = cv2.imdecode(np.fromfile(str(file), dtype=np.uint8), cv2.IMREAD_GRAYSCALE)
        if image is not None:
            self.template_cache[str(file)] = (modified, image)
        return image

    def find(self, screen: np.ndarray, path: str, rect: Rect) -> tuple[int, int, float] | None:
        template = self.template(path)
        if template is None:
            return None
        th, tw = template.shape[:2]
        if th > screen.shape[0] or tw > screen.shape[1]:
            return None
        result = cv2.matchTemplate(screen, template, cv2.TM_CCOEFF_NORMED)
        _, score, _, location = cv2.minMaxLoc(result)
        if score < float(self.app.config.get("threshold", DEFAULT_THRESHOLD)):
            return None
        return rect.left + location[0] + tw // 2, rect.top + location[1] + th // 2, float(score)

    def confirm_after_delay(
        self,
        capture: mss.MSS,
        rect: Rect,
        image_path: str,
        delay: float,
    ) -> tuple[int, int, float] | None:
        """클릭 직전에 새 화면에서 이미지를 다시 확인합니다."""
        time.sleep(max(0.0, delay))
        fresh_frame = np.asarray(capture.grab(rect.as_mss()))
        fresh_gray = cv2.cvtColor(fresh_frame, cv2.COLOR_BGRA2GRAY)
        return self.find(fresh_gray, image_path, rect)

    def configured_image_click_point(
        self,
        match: tuple[int, int, float],
        image_path: str,
        step: dict,
    ) -> tuple[int, int]:
        """찾은 이미지 중심에 픽셀 보정값을 더해 클릭 좌표를 만듭니다."""
        offset = step.get("image_click_offset", [0, 0])
        try:
            x_offset = int(float(offset[0]))
            y_offset = int(float(offset[1]))
        except (TypeError, ValueError, IndexError):
            x_offset, y_offset = 0, 0
        return match[0] + x_offset, match[1] + y_offset

    def advance(self, key: str, step_count: int, amount: int = 1) -> None:
        next_index = (
            self.step_indexes.get(key, 0) + amount
        ) % step_count
        self.step_indexes[key] = next_index
        self.deadlines.pop(key, None)
        self.step_started_at.pop(key, None)
        if next_index == 0:
            logging.info("%s 루틴 완료", key)

    def loop(self) -> None:
        try:
            with mss.MSS() as capture:
                while not self.stop_event.is_set():
                    config = self.app.config_snapshot()
                    if not config.get("post_routines"):
                        time.sleep(0.5)
                        continue
                    for key, (label, rect) in self.app.targets.items():
                        if self.stop_event.is_set():
                            break
                        # 분면별 step/deadline 상태를 독립적으로 진행합니다.
                        target = config.get("targets", {}).get(key, {})
                        if not target.get("enabled", False):
                            continue
                        steps = steps_for_target(config, target)
                        if not steps:
                            continue
                        routine_id = target.get(
                            "post_routine_id",
                            "default_hunting",
                        )
                        routine_overrides, routine_fallbacks = (
                            target_step_settings(target, routine_id)
                        )
                        routine_click_offsets = target_click_offsets(
                            target,
                            routine_id,
                        )
                        legacy_click_offsets = target_legacy_click_offsets(target)
                        index = self.step_indexes.get(key, 0) % len(steps)
                        step = steps[index]
                        step_id = step["id"]
                        override = routine_overrides.get(step_id) or ""
                        image_path = override or step.get("image", "")
                        step_uses_coordinate = (
                            step.get("fallback") is not None
                            or bool(step.get("coordinate_from_target"))
                        )
                        fallback = None
                        if step_uses_coordinate:
                            image_path = ""
                            fallback = routine_fallbacks.get(step_id)
                            if fallback is None:
                                fallback = step.get("fallback")

                        # 이동할 월드: 분면 전용/공용 이미지가 모두 없으면 즉시 다음 단계.
                        if step.get("skip_if_no_image") and not image_path and not step_uses_coordinate:
                            self.app.set_row_status(
                                key,
                                f"{index + 1}. {step['name']} 이미지 없음 → 다음 단계",
                            )
                            self.advance(key, len(steps))
                            continue

                        now = time.monotonic()
                        started_at = self.step_started_at.setdefault(key, now)
                        delay_before = float(step.get("delay_before", 0.0))
                        if now < started_at + delay_before:
                            remaining = started_at + delay_before - now
                            self.app.set_row_status(
                                key,
                                f"{index + 1}. {step['name']} 전 대기 {remaining:.1f}초",
                            )
                            continue
                        deadline = self.deadlines.setdefault(
                            key,
                            time.monotonic() + float(step.get("timeout", 10.0)),
                        )
                        try:
                            frame = np.asarray(capture.grab(rect.as_mss()))
                            gray = cv2.cvtColor(frame, cv2.COLOR_BGRA2GRAY)
                            match = None

                            pre_death_steps = {
                                item["id"]: item
                                for item in config.get("pre_death_steps", [])
                            }
                            entry_steps = {
                                item["id"]: item
                                for item in config.get("entry_steps", [])
                            }
                            pre_death_stage = self.pre_death_stages.get(key)
                            if pre_death_stage == "sandtimer_wait":
                                sandtimer = entry_steps.get("002_sandtimer")
                                if not sandtimer:
                                    self.pre_death_stages[key] = "home_icon"
                                    self.pre_death_deadlines.pop(key, None)
                                    self.app.set_row_status(
                                        key,
                                        "모래시계 설정 없음 → 집 아이콘 대기",
                                    )
                                    continue

                                sandtimer_override = (
                                    target.get("overrides", {}).get(
                                        "002_sandtimer"
                                    )
                                    or ""
                                )
                                sandtimer_path = (
                                    sandtimer_override
                                    or sandtimer.get("image", "")
                                )
                                sandtimer_match = self.find(
                                    gray,
                                    sandtimer_path,
                                    rect,
                                ) if sandtimer_path else None

                                if sandtimer_match:
                                    time.sleep(
                                        float(
                                            sandtimer.get(
                                                "pre_click_delay",
                                                PRE_CLICK_DELAY,
                                            )
                                        )
                                    )
                                    click_x, click_y = self.configured_image_click_point(
                                        sandtimer_match,
                                        sandtimer_path,
                                        {
                                            **sandtimer,
                                            "image_click_offset": legacy_click_offsets.get(
                                                "002_sandtimer",
                                                [0, 0],
                                            ),
                                        },
                                    )
                                    held_left_click(click_x, click_y)
                                    self.pre_death_stages[key] = "back_button"
                                    self.pre_death_deadlines.pop(key, None)
                                    self.app.set_row_status(
                                        key,
                                        f"사망 전 모래시계 클릭 {click_x},{click_y} → 뒤로가기 대기",
                                    )
                                    continue

                                if time.monotonic() >= self.pre_death_deadlines.get(
                                    key,
                                    0.0,
                                ):
                                    self.pre_death_stages[key] = "home_icon"
                                    self.pre_death_deadlines.pop(key, None)
                                    self.app.set_row_status(
                                        key,
                                        "사망 전 모래시계 미감지(timeout) → 뒤로가기 생략 → 집 아이콘 대기",
                                    )
                                    continue

                                remaining = max(
                                    0.0,
                                    self.pre_death_deadlines.get(key, 0.0)
                                    - time.monotonic(),
                                )
                                self.app.set_row_status(
                                    key,
                                    f"사망 전 모래시계 대기 {remaining:.1f}초",
                                )
                                continue

                            if pre_death_stage == "return_wait":
                                remaining = self.return_deadlines.get(key, 0.0) - time.monotonic()
                                if remaining > 0:
                                    self.app.set_row_status(
                                        key,
                                        f"집 이동 후 대기 {remaining:.1f}초",
                                    )
                                    continue
                                self.pre_death_stages.pop(key, None)
                                self.return_deadlines.pop(key, None)
                                menu_index = next(
                                    (
                                        i
                                        for i, candidate in enumerate(steps)
                                        if candidate.get("id") == "02_menu"
                                    ),
                                    1 if len(steps) > 1 else 0,
                                )
                                self.step_indexes[key] = menu_index
                                self.deadlines.pop(key, None)
                                self.step_started_at.pop(key, None)
                                self.app.set_row_status(
                                    key,
                                    "사망 전 귀환 완료 → 02 메뉴부터 시작",
                                )
                                continue

                            if pre_death_stage in ("back_button", "home_icon"):
                                action_step = pre_death_steps.get(pre_death_stage)
                                if not action_step:
                                    self.pre_death_stages.pop(key, None)
                                    continue
                                action_override = (
                                    target.get("overrides", {}).get(
                                        pre_death_stage
                                    )
                                    or ""
                                )
                                action_path = (
                                    action_override
                                    or action_step.get("image", "")
                                )
                                action_match = self.find(
                                    gray,
                                    action_path,
                                    rect,
                                ) if action_path else None
                                if action_match:
                                    time.sleep(
                                        float(
                                            action_step.get(
                                                "pre_click_delay",
                                                PRE_CLICK_DELAY,
                                            )
                                        )
                                    )
                                    click_x, click_y = self.configured_image_click_point(
                                        action_match,
                                        action_path,
                                        {
                                            **action_step,
                                            "image_click_offset": legacy_click_offsets.get(
                                                pre_death_stage,
                                                [0, 0],
                                            ),
                                        },
                                    )
                                    held_left_click(click_x, click_y)
                                    if pre_death_stage == "back_button":
                                        self.pre_death_stages[key] = "home_icon"
                                        self.app.set_row_status(
                                            key,
                                            f"뒤로가기 클릭 {click_x},{click_y} → 집 아이콘 대기",
                                        )
                                    else:
                                        wait_seconds = float(
                                            config.get(
                                                "return_wait_seconds",
                                                20.0,
                                            )
                                        )
                                        self.pre_death_stages[key] = "return_wait"
                                        self.return_deadlines[key] = (
                                            time.monotonic() + wait_seconds
                                        )
                                        self.app.set_row_status(
                                            key,
                                            f"집 아이콘 클릭 {click_x},{click_y} → {wait_seconds:g}초 대기",
                                        )
                                else:
                                    self.app.set_row_status(
                                        key,
                                        f"{action_step['name']} 이미지 대기",
                                    )
                                continue

                            # 기본 루틴의 첫 단계(01_revive)를 기다리는 동안에는
                            # 001_dyied도 함께 감시합니다. 001이 먼저 발견되면
                            # 001 → 002를 처리한 뒤 다시 01부터 시작합니다.
                            if index == 0:
                                entry_steps = {
                                    item["id"]: item
                                    for item in config.get("entry_steps", [])
                                }
                                entry_stage = self.entry_stages.get(key)
                                if entry_stage == "002_sandtimer":
                                    sandtimer = entry_steps.get("002_sandtimer")
                                    if sandtimer:
                                        sandtimer_override = (
                                            target.get("overrides", {}).get(
                                                "002_sandtimer"
                                            )
                                            or ""
                                        )
                                        sandtimer_path = (
                                            sandtimer_override
                                            or sandtimer.get("image", "")
                                        )
                                        sandtimer_match = self.find(
                                            gray,
                                            sandtimer_path,
                                            rect,
                                        )
                                        # 002를 놓쳤더라도 01이 이미 표시됐다면
                                        # 즉시 기본 루틴으로 합류합니다.
                                        revive_match = self.find(
                                            gray,
                                            image_path,
                                            rect,
                                        ) if image_path else None
                                        if sandtimer_match:
                                            time.sleep(
                                                float(
                                                    sandtimer.get(
                                                        "pre_click_delay",
                                                        PRE_CLICK_DELAY,
                                                    )
                                                )
                                            )
                                            held_left_click(
                                                sandtimer_match[0],
                                                sandtimer_match[1],
                                            )
                                            self.entry_stages.pop(key, None)
                                            self.entry_deadlines.pop(key, None)
                                            self.app.set_row_status(
                                                key,
                                                "진입 002 모래시계 클릭 → 01 대기",
                                            )
                                            continue
                                        if revive_match:
                                            self.entry_stages.pop(key, None)
                                            self.entry_deadlines.pop(key, None)
                                            match = revive_match
                                        elif time.monotonic() >= self.entry_deadlines.get(
                                            key,
                                            0.0,
                                        ):
                                            self.entry_stages.pop(key, None)
                                            self.entry_deadlines.pop(key, None)
                                            self.app.set_row_status(
                                                key,
                                                "002 시간 초과 → 01 대기",
                                            )
                                            continue
                                        else:
                                            self.app.set_row_status(
                                                key,
                                                "진입 002 모래시계 대기",
                                            )
                                            continue
                                elif entry_stage is None:
                                    dyied = entry_steps.get("001_dyied")
                                    if dyied:
                                        dyied_override = (
                                            target.get("overrides", {}).get(
                                                "001_dyied"
                                            )
                                            or ""
                                        )
                                        dyied_path = (
                                            dyied_override
                                            or dyied.get("image", "")
                                        )
                                        dyied_match = self.find(
                                            gray,
                                            dyied_path,
                                            rect,
                                        )
                                        if dyied_match:
                                            logging.info("%s 사망 진입 루틴 시작", key)
                                            time.sleep(
                                                float(
                                                    dyied.get(
                                                        "pre_click_delay",
                                                        PRE_CLICK_DELAY,
                                                    )
                                                )
                                            )
                                            held_left_click(
                                                dyied_match[0],
                                                dyied_match[1],
                                            )
                                            sandtimer = entry_steps.get(
                                                "002_sandtimer",
                                                {},
                                            )
                                            self.entry_stages[key] = (
                                                "002_sandtimer"
                                            )
                                            self.entry_deadlines[key] = (
                                                time.monotonic()
                                                + float(
                                                    sandtimer.get(
                                                        "timeout",
                                                        15.0,
                                                    )
                                                )
                                            )
                                            self.app.set_row_status(
                                                key,
                                                "진입 001 사망 화면 클릭 → 002 대기",
                                            )
                                            continue

                            if match is None:
                                match = self.find(
                                    gray,
                                    image_path,
                                    rect,
                                ) if image_path else None

                            # 사망/부활 화면이 아닌 정상 사냥 화면에서 물약 10개
                            # 이미지를 발견하면 사망 전 귀환 루틴을 시작합니다.
                            if index == 0 and match is None:
                                potion_step = pre_death_steps.get("potion_10")
                                if potion_step:
                                    potion_override = (
                                        target.get("overrides", {}).get(
                                            "potion_10"
                                        )
                                        or ""
                                    )
                                    potion_path = (
                                        potion_override
                                        or potion_step.get("image", "")
                                    )
                                    potion_match = self.find(
                                        gray,
                                        potion_path,
                                        rect,
                                    ) if potion_path else None
                                    if potion_match:
                                        logging.info("%s 사망 전 귀환 루틴 시작", key)
                                        sandtimer = entry_steps.get(
                                            "002_sandtimer",
                                            {},
                                        )
                                        timeout = max(
                                            0.0,
                                            float(
                                                sandtimer.get(
                                                    "timeout",
                                                    15.0,
                                                )
                                            ),
                                        )
                                        self.pre_death_stages[key] = "sandtimer_wait"
                                        self.pre_death_deadlines[key] = (
                                            time.monotonic() + timeout
                                        )
                                        self.app.set_row_status(
                                            key,
                                            f"물약 10개 감지 → 사망 전 모래시계 {timeout:g}초 대기",
                                        )
                                        continue
                            if match:
                                confirmed_match = self.confirm_after_delay(
                                    capture,
                                    rect,
                                    image_path,
                                    float(
                                        step.get(
                                            "pre_click_delay",
                                            PRE_CLICK_DELAY,
                                        )
                                    ),
                                )
                                if confirmed_match is None:
                                    self.app.set_row_status(
                                        key,
                                        f"{index + 1}. {step['name']} 재확인 실패 → 클릭 취소",
                                    )
                                    continue
                                logging.info("%s 루틴 진행 시작", key)
                                click_x, click_y = self.configured_image_click_point(
                                    confirmed_match,
                                    image_path,
                                    {
                                        **step,
                                        "image_click_offset": routine_click_offsets.get(
                                            step_id,
                                            [0, 0],
                                        ),
                                    },
                                )
                                held_left_click(click_x, click_y)
                                self.app.set_row_status(
                                    key,
                                    f"{index + 1}. {step['name']} 클릭 {click_x},{click_y} ({confirmed_match[2]:.3f})",
                                )
                                time.sleep(
                                    max(
                                        0.0,
                                        float(
                                            step.get(
                                                "after_click_delay",
                                                0.0,
                                            )
                                        ),
                                    )
                                )
                                self.advance(key, len(steps))
                            elif time.monotonic() >= deadline:
                                if fallback and len(fallback) == 2:
                                    x, y = rect.left + int(fallback[0]), rect.top + int(fallback[1])
                                    time.sleep(
                                        float(
                                            step.get(
                                                "pre_click_delay",
                                                PRE_CLICK_DELAY,
                                            )
                                        )
                                    )
                                    held_left_click(x, y)
                                    self.app.set_row_status(
                                        key, f"{index + 1}. 미검출 → 좌표 클릭"
                                    )
                                    self.advance(key, len(steps))
                                elif step.get("on_timeout") == "click_current":
                                    time.sleep(
                                        float(
                                            step.get(
                                                "pre_click_delay",
                                                PRE_CLICK_DELAY,
                                            )
                                        )
                                    )
                                    held_left_click()
                                    self.app.set_row_status(
                                        key,
                                        f"{index + 1}. 미검출 → 현재 위치 클릭",
                                    )
                                    self.advance(key, len(steps))
                                elif step.get("on_timeout") == "skip":
                                    skip_count = max(1, int(step.get("skip_count", 1)))
                                    self.app.set_row_status(
                                        key,
                                        f"{index + 1}. 미검출 → {skip_count}단계 이동",
                                    )
                                    self.advance(key, len(steps), skip_count)
                                else:
                                    self.app.set_row_status(
                                        key, f"{index + 1}. 이미지 대기 (fallback 없음)"
                                    )
                                    self.deadlines[key] = time.monotonic() + float(
                                        step.get("timeout", 10.0)
                                    )
                        except Exception as exc:
                            logging.exception("%s 감시 오류", label)
                            self.app.set_row_status(key, f"오류: {exc}")
                    time.sleep(SCAN_INTERVAL)
        except Exception as exc:
            logging.exception("감시 엔진 종료")
            self.app.set_global_status(f"감시 엔진 오류: {exc}")


class CropDialog(tk.Toplevel):
    def __init__(self, parent: tk.Misc, image: np.ndarray) -> None:
        super().__init__(parent)
        self.title("캡처 영역 선택")
        self.transient(parent)
        self.result: tuple[int, int, int, int] | None = None
        self.start_point: tuple[int, int] | None = None
        self.rectangle: int | None = None
        original_height, original_width = image.shape[:2]
        self.scale = min(1.0, 1400 / original_width, 760 / original_height)
        display_width = max(1, round(original_width * self.scale))
        display_height = max(1, round(original_height * self.scale))
        if self.scale < 1.0:
            display = cv2.resize(
                image,
                (display_width, display_height),
                interpolation=cv2.INTER_AREA,
            )
        else:
            display = image

        success, encoded = cv2.imencode(".png", display)
        if not success:
            raise RuntimeError("캡처 미리보기 생성 실패")
        png_data = base64.b64encode(encoded.tobytes()).decode("ascii")
        self.photo = tk.PhotoImage(data=png_data)

        ttk.Label(
            self,
            text="저장할 부분을 마우스로 드래그하세요.  Esc 또는 취소를 누르면 닫힙니다.",
            font=("Malgun Gothic", 11),
            padding=8,
        ).pack(fill="x")
        self.canvas = tk.Canvas(
            self,
            width=display_width,
            height=display_height,
            cursor="crosshair",
            highlightthickness=0,
        )
        self.canvas.pack(padx=10)
        self.canvas.create_image(0, 0, image=self.photo, anchor="nw")
        self.canvas.bind("<ButtonPress-1>", self.begin_selection)
        self.canvas.bind("<B1-Motion>", self.update_selection)
        self.canvas.bind("<ButtonRelease-1>", self.update_selection)

        buttons = ttk.Frame(self, padding=10)
        buttons.pack(fill="x")
        ttk.Button(buttons, text="선택 저장", command=self.confirm).pack(
            side="right", padx=4
        )
        ttk.Button(buttons, text="취소", command=self.cancel).pack(
            side="right", padx=4
        )
        self.bind("<Return>", lambda _event: self.confirm())
        self.bind("<Escape>", lambda _event: self.cancel())
        self.protocol("WM_DELETE_WINDOW", self.cancel)
        self.resizable(False, False)
        self.update_idletasks()
        center_on_parent(
            self,
            parent,
            self.winfo_reqwidth(),
            self.winfo_reqheight(),
        )
        self.grab_set()
        self.focus_force()

    def bounded_point(self, event: tk.Event) -> tuple[int, int]:
        x = max(0, min(int(event.x), int(self.canvas["width"])))
        y = max(0, min(int(event.y), int(self.canvas["height"])))
        return x, y

    def begin_selection(self, event: tk.Event) -> None:
        self.start_point = self.bounded_point(event)
        if self.rectangle is not None:
            self.canvas.delete(self.rectangle)
        x, y = self.start_point
        self.rectangle = self.canvas.create_rectangle(
            x,
            y,
            x,
            y,
            outline="#00a2ff",
            width=3,
        )

    def update_selection(self, event: tk.Event) -> None:
        if self.start_point is None or self.rectangle is None:
            return
        x, y = self.bounded_point(event)
        self.canvas.coords(
            self.rectangle,
            self.start_point[0],
            self.start_point[1],
            x,
            y,
        )

    def confirm(self) -> None:
        if self.rectangle is None:
            messagebox.showinfo(
                "영역 선택",
                "저장할 부분을 먼저 드래그하세요.",
                parent=self,
            )
            return
        x1, y1, x2, y2 = self.canvas.coords(self.rectangle)
        left, right = sorted((x1, x2))
        top, bottom = sorted((y1, y2))
        if right - left < 2 or bottom - top < 2:
            messagebox.showinfo(
                "영역 선택",
                "조금 더 큰 영역을 선택하세요.",
                parent=self,
            )
            return
        self.result = (
            round(left / self.scale),
            round(top / self.scale),
            round((right - left) / self.scale),
            round((bottom - top) / self.scale),
        )
        self.grab_release()
        self.destroy()

    def cancel(self) -> None:
        self.result = None
        try:
            self.grab_release()
        except tk.TclError:
            pass
        self.destroy()


class TargetEditor(tk.Toplevel):
    def __init__(self, app: "MacroManager", key: str) -> None:
        super().__init__(app.root)
        self.app, self.key = app, key
        self.title(f"분면별 루틴 설정 - {app.targets[key][0]}")
        self.transient(app.root)
        self.minsize(1700, 900)
        center_on_parent(self, app.root, 2050, 1040)
        self.rows: list[dict] = []
        target = app.config["targets"].setdefault(key, {})
        selector = ttk.Frame(self, padding=(12, 8))
        selector.pack(fill="x")
        ttk.Label(
            selector,
            text="이 분면에서 실행할 전체 루틴:",
            font=("Malgun Gothic", 10, "bold"),
        ).pack(side="left")
        self.routine_name_to_id = {
            routine.get("name", routine_id): routine_id
            for routine_id, routine in app.config.get("post_routines", {}).items()
        }
        current_id = target.get("post_routine_id", "default_hunting")
        current_name = next(
            (name for name, rid in self.routine_name_to_id.items() if rid == current_id),
            next(iter(self.routine_name_to_id), ""),
        )
        self.routine_var = tk.StringVar(value=current_name)
        routine_combo = ttk.Combobox(
            selector,
            textvariable=self.routine_var,
            values=list(self.routine_name_to_id),
            state="readonly",
            width=32,
        )
        routine_combo.pack(side="left", padx=8)
        routine_combo.bind("<<ComboboxSelected>>", self.change_routine)
        ttk.Button(
            selector,
            text="루틴 만들기·편집",
            command=self.edit_routines,
        ).pack(side="left", padx=4)
        ttk.Label(
            selector,
            text=(
                "※ 클릭 보정 0,0은 찾은 이미지 정중앙입니다. "
                "+X=오른쪽, -X=왼쪽, +Y=아래, -Y=위"
            ),
        ).pack(side="left", padx=12)
        outer = ttk.Frame(self, padding=10)
        outer.pack(fill="both", expand=True)
        canvas = tk.Canvas(outer)
        scrollbar = ttk.Scrollbar(outer, orient="vertical", command=canvas.yview)
        self.body = ttk.Frame(canvas)
        self.body.bind("<Configure>", lambda _e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=self.body, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
        headers = (
            "단계 (클릭=캡처)",
            "공용 이미지",
            "현재 적용 이미지 (변경 시 분면 전용)",
            "클릭 보정 X",
            "Y",
            "좌표 X",
            "Y",
            "",
        )
        for col, text in enumerate(headers):
            ttk.Label(self.body, text=text).grid(row=0, column=col, padx=4, pady=5)
        legacy_overrides = target.setdefault("overrides", {})
        legacy_fallbacks = target.setdefault("fallbacks", {})
        selected_routine_id = target.get("post_routine_id", "default_hunting")
        routine_overrides, routine_fallbacks = target_step_settings(
            target,
            selected_routine_id,
        )
        routine_click_offsets = target_click_offsets(
            target,
            selected_routine_id,
        )
        legacy_click_offsets = target_legacy_click_offsets(target)
        display_steps = [
            *((step, "legacy") for step in app.config.get("pre_death_steps", [])),
            *((step, "legacy") for step in app.config.get("entry_steps", [])),
            *((step, "routine") for step in steps_for_target(app.config, target)),
        ]
        for row_index, (step, scope) in enumerate(display_steps, 1):
            sid = step["id"]
            overrides = legacy_overrides if scope == "legacy" else routine_overrides
            fallbacks = legacy_fallbacks if scope == "legacy" else routine_fallbacks
            coordinate_step = (
                step.get("fallback") is not None
                or bool(step.get("coordinate_from_target"))
            )
            common_image = step.get("image", "")
            override_var = tk.StringVar(
                value=""
                if coordinate_step
                else overrides.get(sid, "") or common_image
            )
            point = fallbacks.get(sid) or ["", ""] if coordinate_step else ["", ""]
            x_var, y_var = tk.StringVar(value=str(point[0])), tk.StringVar(value=str(point[1]))
            click_offsets = (
                legacy_click_offsets
                if scope == "legacy"
                else routine_click_offsets
            )
            click_offset = click_offsets.get(sid, [0, 0])
            click_x_var = tk.StringVar(value=str(click_offset[0]))
            click_y_var = tk.StringVar(value=str(click_offset[1]))
            # 이미지 기반 단계는 사망 전/진입 단계까지 모두 클릭 보정을 설정할 수 있습니다.
            image_editable = not coordinate_step
            click_enabled = not coordinate_step
            stage_label = ttk.Label(
                self.body,
                text=f"{row_index}. {step['name']}",
                cursor="hand2",
            )
            stage_label.grid(
                row=row_index,
                column=0,
                sticky="w",
            )
            stage_label.bind(
                "<Button-1>",
                lambda _event, variable=override_var, current=step: self.preview_image(
                    variable,
                    current,
                ),
            )
            ttk.Label(
                self.body,
                text=common_image or "(없음)",
                width=20,
            ).grid(row=row_index, column=1)
            override_entry = ttk.Entry(
                self.body,
                textvariable=override_var,
                width=75,
                state="normal" if image_editable else "disabled",
            )
            override_entry.grid(row=row_index, column=2, padx=3)
            ttk.Entry(
                self.body,
                textvariable=click_x_var,
                width=8,
                state="normal" if click_enabled else "disabled",
            ).grid(row=row_index, column=3)
            ttk.Entry(
                self.body,
                textvariable=click_y_var,
                width=8,
                state="normal" if click_enabled else "disabled",
            ).grid(row=row_index, column=4)
            ttk.Entry(
                self.body,
                textvariable=x_var,
                width=6,
                state="normal" if coordinate_step else "disabled",
            ).grid(row=row_index, column=5, padx=2)
            ttk.Entry(
                self.body,
                textvariable=y_var,
                width=6,
                state="normal" if coordinate_step else "disabled",
            ).grid(row=row_index, column=6, padx=2)
            buttons = ttk.Frame(self.body)
            buttons.grid(row=row_index, column=7, padx=4)
            image_button_state = "normal" if image_editable else "disabled"
            ttk.Button(buttons, text="파일", state=image_button_state, command=lambda v=override_var: self.choose(v)).pack(side="left")
            ttk.Button(
                buttons,
                text="공용",
                state=image_button_state,
                command=lambda v=override_var, common=common_image: v.set(common),
            ).pack(side="left")
            ttk.Button(buttons, text="캡처", state=image_button_state, command=lambda v=override_var, s=step: self.capture(v, s)).pack(side="left")
            self.rows.append({
                "id": sid,
                "override": override_var,
                "common": common_image,
                "x": x_var,
                "y": y_var,
                "click_x": click_x_var,
                "click_y": click_y_var,
                "coordinate": coordinate_step,
                "click_enabled": click_enabled,
                "scope": scope,
            })
        ttk.Button(self, text="저장", command=self.save).pack(pady=8)

    def choose(self, variable: tk.StringVar) -> None:
        path = filedialog.askopenfilename(filetypes=[("PNG 이미지", "*.png"), ("이미지", "*.png *.jpg *.bmp")])
        if path:
            variable.set(path)

    def capture(self, variable: tk.StringVar, step: dict) -> None:
        path = self.app.capture_and_crop(self.key, step["id"])
        if path:
            variable.set(path)

    def preview_image(self, variable: tk.StringVar, step: dict) -> None:
        configured = variable.get().strip() or step.get("image", "")
        common_image = step.get("image", "")
        source = (
            "분면별 이미지"
            if configured and configured != common_image
            else "공용 이미지"
        )
        if not configured:
            messagebox.showinfo(
                "등록된 이미지 없음",
                f"{step['name']} 단계에는 이미지가 없습니다.\n좌표 클릭 단계일 수 있습니다.",
                parent=self,
            )
            return
        image_path = Path(configured)
        if not image_path.is_absolute():
            image_path = BASE_DIR / image_path
        if not image_path.exists():
            messagebox.showerror(
                "이미지 파일 없음",
                f"등록된 파일을 찾을 수 없습니다.\n\n{image_path}",
                parent=self,
            )
            return
        try:
            photo = tk.PhotoImage(file=str(image_path))
        except tk.TclError as exc:
            messagebox.showerror(
                "미리보기 실패",
                f"이미지를 열 수 없습니다.\n{exc}",
                parent=self,
            )
            return

        max_width, max_height = 1000, 650
        scale = max(
            1,
            math.ceil(photo.width() / max_width),
            math.ceil(photo.height() / max_height),
        )
        if scale > 1:
            photo = photo.subsample(scale, scale)

        preview = tk.Toplevel(self)
        preview.title(f"이미지 미리보기 - {step['name']}")
        preview.transient(self)
        ttk.Label(
            preview,
            text=f"{source}: {image_path}",
            padding=(10, 8),
        ).pack(fill="x")
        image_label = ttk.Label(preview, image=photo, padding=10)
        image_label.image = photo
        image_label.pack(fill="both", expand=True)
        ttk.Button(preview, text="닫기", command=preview.destroy).pack(pady=(0, 10))
        center_on_parent(
            preview,
            self,
            min(photo.width() + 40, 1060),
            min(photo.height() + 100, 750),
        )

    def change_routine(self, _event: tk.Event | None = None) -> None:
        routine_id = self.routine_name_to_id.get(self.routine_var.get())
        if not routine_id:
            return
        target = self.app.config["targets"].setdefault(self.key, {})
        target["post_routine_id"] = routine_id
        self.app.persist()
        self.app.engine.reset_target(self.key)
        self.app.refresh_main_routine_choices()
        self.destroy()
        TargetEditor(self.app, self.key)

    def edit_routines(self) -> None:
        manager = EditableRoutineManager(
            self.app,
            initial_capture_key=self.key,
            initial_routine_id=self.app.config["targets"]
            .get(self.key, {})
            .get("post_routine_id", "default_hunting"),
        )
        self.wait_window(manager)
        if self.winfo_exists():
            self.destroy()
            TargetEditor(self.app, self.key)

    def save(self) -> None:
        target = self.app.config["targets"].setdefault(self.key, {})
        # 다른 루틴에서 같은 내부 단계 ID를 사용할 수 있으므로 현재 루틴에서
        # 비활성인 이미지/좌표 값은 삭제하지 않고 보존합니다.
        legacy_overrides = dict(target.get("overrides", {}))
        legacy_fallbacks = dict(target.get("fallbacks", {}))
        routine_id = self.routine_name_to_id.get(
            self.routine_var.get(),
            "default_hunting",
        )
        routine_click_offsets = dict(
            target_click_offsets(target, routine_id)
        )
        legacy_click_offsets = dict(
            target_legacy_click_offsets(target)
        )
        current_overrides, current_fallbacks = target_step_settings(
            target,
            routine_id,
        )
        if routine_id == "default_hunting":
            routine_overrides = legacy_overrides
            routine_fallbacks = legacy_fallbacks
        else:
            routine_overrides = dict(current_overrides)
            routine_fallbacks = dict(current_fallbacks)
        try:
            for row in self.rows:
                if row["scope"] == "legacy":
                    overrides, fallbacks = legacy_overrides, legacy_fallbacks
                else:
                    overrides, fallbacks = routine_overrides, routine_fallbacks
                if row["coordinate"]:
                    x, y = row["x"].get().strip(), row["y"].get().strip()
                    if x or y:
                        if not x or not y:
                            raise ValueError
                        fallbacks[row["id"]] = [int(x), int(y)]
                    else:
                        fallbacks.pop(row["id"], None)
                else:
                    override = row["override"].get().strip()
                    if override and override != row["common"]:
                        overrides[row["id"]] = override
                    else:
                        overrides.pop(row["id"], None)
                if row["click_enabled"]:
                    click_x_text = row["click_x"].get().strip() or "0"
                    click_y_text = row["click_y"].get().strip() or "0"
                    click_x = int(float(click_x_text))
                    click_y = int(float(click_y_text))
                    click_offsets = (
                        legacy_click_offsets
                        if row["scope"] == "legacy"
                        else routine_click_offsets
                    )
                    if click_x or click_y:
                        click_offsets[row["id"]] = [click_x, click_y]
                    else:
                        click_offsets.pop(row["id"], None)
        except ValueError:
            messagebox.showerror("좌표 오류", "X와 Y에는 정수를 입력하세요.", parent=self)
            return
        target["overrides"], target["fallbacks"] = (
            legacy_overrides,
            legacy_fallbacks,
        )
        target["legacy_click_offsets"] = legacy_click_offsets
        if routine_id == "default_hunting":
            target["overrides"], target["fallbacks"] = (
                routine_overrides,
                routine_fallbacks,
            )
        else:
            target.setdefault("routine_settings", {})[routine_id] = {
                "overrides": routine_overrides,
                "fallbacks": routine_fallbacks,
                "click_offsets": routine_click_offsets,
            }
        if routine_id == "default_hunting":
            target["click_offsets"] = routine_click_offsets
        if routine_id:
            target["post_routine_id"] = routine_id
        self.app.persist()
        self.destroy()


class CommonRoutineEditor(tk.Toplevel):
    GROUP_LABELS = {
        "pre_death_steps": "사망 전",
        "entry_steps": "사망 후 진입",
        "steps": "기본 루틴",
    }

    def __init__(self, app: "MacroManager") -> None:
        super().__init__(app.root)
        self.app = app
        self.title("공용 루틴 이미지 설정")
        self.transient(app.root)
        self.minsize(1450, 850)
        center_on_parent(self, app.root, 1780, 1000)
        self.rows: list[dict] = []

        source_frame = ttk.Frame(self, padding=(12, 10))
        source_frame.pack(fill="x")
        ttk.Label(
            source_frame,
            text="캡처할 화면:",
            font=("Malgun Gothic", 11, "bold"),
        ).pack(side="left")
        self.source_label_to_key = {
            label: key for key, (label, _rect) in app.targets.items()
        }
        self.capture_source_var = tk.StringVar(
            value=next(iter(self.source_label_to_key), "")
        )
        ttk.Combobox(
            source_frame,
            textvariable=self.capture_source_var,
            values=list(self.source_label_to_key),
            state="readonly",
            width=28,
        ).pack(side="left", padx=8)
        ttk.Label(
            source_frame,
            text="각 행에서 파일 선택 또는 캡처 후 마지막에 저장하세요.",
        ).pack(side="left", padx=12)

        outer = ttk.Frame(self, padding=(10, 0, 10, 8))
        outer.pack(fill="both", expand=True)
        canvas = tk.Canvas(outer, highlightthickness=0)
        scrollbar = ttk.Scrollbar(
            outer,
            orient="vertical",
            command=canvas.yview,
        )
        self.body = ttk.Frame(canvas)
        body_window = canvas.create_window(
            (0, 0),
            window=self.body,
            anchor="nw",
        )
        self.body.bind(
            "<Configure>",
            lambda _event: canvas.configure(
                scrollregion=canvas.bbox("all")
            ),
        )
        canvas.bind(
            "<Configure>",
            lambda event: canvas.itemconfigure(
                body_window,
                width=event.width,
            ),
        )
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        headers = (
            "구분",
            "단계",
            "공용 이미지",
            "검색 제한시간",
            "클릭 전 대기",
            "",
        )
        for column, text in enumerate(headers):
            ttk.Label(
                self.body,
                text=text,
                font=("Malgun Gothic", 10, "bold"),
            ).grid(row=0, column=column, padx=4, pady=7)
        self.body.columnconfigure(2, weight=1)

        row_number = 1
        for group in ("pre_death_steps", "entry_steps", "steps"):
            for step in app.config.get(group, []):
                image_var = tk.StringVar(value=step.get("image", ""))
                timeout_var = tk.StringVar(
                    value=str(step.get("timeout", 10))
                )
                delay_var = tk.StringVar(
                    value=str(
                        step.get("pre_click_delay", PRE_CLICK_DELAY)
                    )
                )
                ttk.Label(
                    self.body,
                    text=self.GROUP_LABELS[group],
                    width=13,
                ).grid(row=row_number, column=0, padx=3, pady=2)
                ttk.Label(
                    self.body,
                    text=step["name"],
                    width=24,
                    anchor="w",
                ).grid(row=row_number, column=1, padx=3, pady=2)
                ttk.Entry(
                    self.body,
                    textvariable=image_var,
                ).grid(
                    row=row_number,
                    column=2,
                    sticky="ew",
                    padx=3,
                    pady=2,
                )
                ttk.Entry(
                    self.body,
                    textvariable=timeout_var,
                    width=12,
                ).grid(row=row_number, column=3, padx=3, pady=2)
                ttk.Entry(
                    self.body,
                    textvariable=delay_var,
                    width=12,
                ).grid(row=row_number, column=4, padx=3, pady=2)
                buttons = ttk.Frame(self.body)
                buttons.grid(row=row_number, column=5, padx=4, pady=2)
                ttk.Button(
                    buttons,
                    text="파일",
                    command=lambda variable=image_var: self.choose_image(
                        variable
                    ),
                ).pack(side="left")
                ttk.Button(
                    buttons,
                    text="비우기",
                    command=lambda variable=image_var: variable.set(""),
                ).pack(side="left")
                ttk.Button(
                    buttons,
                    text="캡처",
                    command=lambda variable=image_var, current=step: self.capture_image(
                        variable,
                        current,
                    ),
                ).pack(side="left")
                self.rows.append(
                    {
                        "group": group,
                        "step": dict(step),
                        "image": image_var,
                        "timeout": timeout_var,
                        "delay": delay_var,
                    }
                )
                row_number += 1

        bottom = ttk.Frame(self, padding=10)
        bottom.pack(fill="x")
        ttk.Button(
            bottom,
            text="취소",
            command=self.destroy,
            width=16,
        ).pack(side="right", padx=4)
        ttk.Button(
            bottom,
            text="저장",
            command=self.save,
            width=16,
        ).pack(side="right", padx=4)

    def choose_image(self, variable: tk.StringVar) -> None:
        path = filedialog.askopenfilename(
            parent=self,
            initialdir=BASE_DIR / "images",
            filetypes=[
                ("이미지", "*.png *.jpg *.bmp"),
                ("모든 파일", "*.*"),
            ],
        )
        if path:
            variable.set(path)

    def change_routine(self, _event: tk.Event | None = None) -> None:
        routine_id = self.routine_name_to_id.get(self.routine_var.get())
        if not routine_id:
            return
        self.app.config["targets"].setdefault(self.key, {})[
            "post_routine_id"
        ] = routine_id
        self.app.persist()
        self.destroy()


class PostRoutineManager(tk.Toplevel):
    """01_revive부터 마지막 단계까지의 전체 공용 루틴을 관리합니다."""

    def __init__(self, app: "MacroManager") -> None:
        super().__init__(app.root)
        self.app = app
        self.title("전체 자동화 루틴 만들기·편집")
        self.transient(app.root)
        self.minsize(1250, 850)
        center_on_parent(self, app.root, 1550, 1000)

        # 기본 Treeview 행 높이는 Windows 배율이 적용된 맑은 고딕 글꼴보다
        # 작을 수 있으므로 이 창 전용 스타일로 글자 겹침을 방지합니다.
        style = ttk.Style(self)
        style.configure(
            "PostRoutine.Treeview",
            font=("Malgun Gothic", 11),
            rowheight=32,
        )
        style.configure(
            "PostRoutine.Treeview.Heading",
            font=("Malgun Gothic", 11, "bold"),
            padding=(6, 7),
        )

        guide = ttk.Frame(self, padding=(14, 12, 14, 6))
        guide.pack(fill="x")
        ttk.Label(
            guide,
            text="01부터 마지막 단계까지 실행할 전체 자동화 루틴",
            font=("Malgun Gothic", 13, "bold"),
        ).pack(anchor="w")
        ttk.Label(
            guide,
            text=(
                "기본 루틴은 현재 사용 중인 01 부활 → 02 메뉴 → 장비·상점 처리 → "
                "15 월드맵 → 지역·사냥터 이동 → 21 AUTO까지의 전체 과정입니다."
            ),
            font=("Malgun Gothic", 10),
        ).pack(anchor="w", pady=(5, 1))
        ttk.Label(
            guide,
            text=(
                "새 루틴은 01부터 21까지 기본 루틴 전체를 복사해 만듭니다. "
                "복사본에서 단계 추가·삭제, 이미지·좌표와 실행 순서를 변경하세요."
            ),
            foreground="#245a9b",
            font=("Malgun Gothic", 10, "bold"),
        ).pack(anchor="w")

        left = ttk.Frame(self, padding=10)
        left.pack(side="left", fill="y")
        ttk.Label(
            left,
            text="사용 가능한 전체 루틴",
            font=("Malgun Gothic", 11, "bold"),
        ).pack(pady=(0, 6))
        self.routine_list = tk.Listbox(left, width=28, height=24)
        self.routine_list.pack(fill="y", expand=True)
        self.routine_list.bind("<<ListboxSelect>>", self.refresh_steps)
        for text, command in (
            ("기본 전체 루틴으로 새로 만들기", self.new_routine),
            ("선택 루틴 복제", self.duplicate_routine),
            ("선택 루틴 이름 변경", self.rename_routine),
            ("선택 루틴 삭제", self.delete_routine),
        ):
            ttk.Button(left, text=text, command=command, width=28).pack(
                pady=3
            )

        right = ttk.Frame(self, padding=10)
        right.pack(side="left", fill="both", expand=True)
        self.selected_name_var = tk.StringVar(value="루틴을 선택하세요")
        ttk.Label(
            right,
            textvariable=self.selected_name_var,
            font=("Malgun Gothic", 13, "bold"),
        ).pack(anchor="w", pady=(0, 8))
        self.tree = ttk.Treeview(
            right,
            columns=("order", "name", "action", "value", "timeout", "delay"),
            show="headings",
            height=15,
            style="PostRoutine.Treeview",
        )
        for column, title, width in (
            ("order", "순서", 65),
            ("name", "단계 이름", 250),
            ("action", "동작", 110),
            ("value", "공용 이미지/좌표", 470),
            ("timeout", "제한시간", 95),
            ("delay", "클릭 전 대기", 105),
        ):
            self.tree.heading(column, text=title)
            self.tree.column(column, width=width, minwidth=width)
        self.tree.column("order", anchor="center")
        self.tree.column("timeout", anchor="center")
        self.tree.column("delay", anchor="center")
        self.tree.pack(fill="both", expand=True)
        self.tree.bind("<<TreeviewSelect>>", self.update_step_details)
        self.tree.bind("<Double-1>", self.begin_inline_edit)
        self.inline_editor: tk.Widget | None = None
        self.step_detail_var = tk.StringVar(
            value="셀을 더블클릭하면 표 안에서 바로 수정할 수 있습니다. Enter=저장, Esc=취소"
        )
        ttk.Label(
            right,
            textvariable=self.step_detail_var,
            relief="groove",
            padding=(10, 7),
            anchor="w",
        ).pack(fill="x", pady=(7, 0))
        editor = ttk.LabelFrame(right, text="선택한 행 수정", padding=8)
        editor.pack(fill="x", pady=(7, 0))
        self.row_name_var = tk.StringVar()
        self.row_action_var = tk.StringVar(value="이미지 클릭")
        self.row_value_var = tk.StringVar()
        self.row_timeout_var = tk.StringVar()
        self.row_delay_var = tk.StringVar()
        editor.columnconfigure(1, weight=2)
        editor.columnconfigure(5, weight=4)
        ttk.Label(editor, text="단계 이름").grid(row=0, column=0, padx=3)
        self.row_name_entry = ttk.Entry(editor, textvariable=self.row_name_var)
        self.row_name_entry.grid(row=0, column=1, sticky="ew", padx=3)
        ttk.Label(editor, text="동작").grid(row=0, column=2, padx=3)
        ttk.Combobox(
            editor,
            textvariable=self.row_action_var,
            values=("이미지 클릭", "좌표 클릭"),
            state="readonly",
            width=12,
        ).grid(row=0, column=3, padx=3)
        ttk.Label(editor, text="이미지 경로 또는 X,Y").grid(row=0, column=4, padx=3)
        ttk.Entry(editor, textvariable=self.row_value_var).grid(
            row=0, column=5, sticky="ew", padx=3
        )
        ttk.Button(editor, text="파일", command=self.choose_row_image).grid(
            row=0, column=6, padx=3
        )
        ttk.Label(editor, text="제한시간(초)").grid(row=1, column=0, padx=3, pady=(7, 0))
        ttk.Entry(editor, textvariable=self.row_timeout_var, width=10).grid(
            row=1, column=1, sticky="w", padx=3, pady=(7, 0)
        )
        ttk.Label(editor, text="클릭 전 대기(초)").grid(row=1, column=2, padx=3, pady=(7, 0))
        ttk.Entry(editor, textvariable=self.row_delay_var, width=10).grid(
            row=1, column=3, sticky="w", padx=3, pady=(7, 0)
        )
        ttk.Button(
            editor,
            text="선택 행에 적용",
            command=self.apply_row_editor,
            width=18,
        ).grid(row=1, column=5, sticky="e", padx=3, pady=(7, 0))
        buttons = ttk.Frame(right)
        buttons.pack(fill="x", pady=8)
        for text, command in (
            ("선택 행 아래 이미지 단계 추가", self.add_image_step),
            ("선택 행 아래 좌표 단계 추가", self.add_coordinate_step),
            ("선택 행 수정칸으로 이동", self.edit_step_settings),
            ("선택 단계 이미지 변경", self.change_step_image),
            ("선택 단계 삭제", self.delete_step),
            ("위로", lambda: self.move_step(-1)),
            ("아래로", lambda: self.move_step(1)),
        ):
            ttk.Button(buttons, text=text, command=command).pack(
                side="left", padx=2
            )
        ttk.Button(
            right,
            text="닫기",
            command=self.destroy,
            width=18,
        ).pack(pady=4)
        self.routine_ids: list[str] = []
        self.refresh_routines()

    def selected_routine_id(self) -> str | None:
        selected = self.routine_list.curselection()
        if not selected:
            return None
        return self.routine_ids[selected[0]]

    def refresh_routines(self, select_id: str | None = None) -> None:
        self.routine_list.delete(0, "end")
        self.routine_ids = []
        for routine_id, routine in self.app.config.get(
            "post_routines",
            {},
        ).items():
            self.routine_ids.append(routine_id)
            display_name = routine["name"]
            if routine_id == "default_hunting":
                display_name = f"[기본 템플릿] {display_name}"
            self.routine_list.insert("end", display_name)
        if self.routine_ids:
            index = (
                self.routine_ids.index(select_id)
                if select_id in self.routine_ids
                else 0
            )
            self.routine_list.selection_set(index)
            self.routine_list.activate(index)
        self.refresh_steps()

    def refresh_steps(
        self,
        _event: tk.Event | None = None,
        select_step_id: str | None = None,
    ) -> None:
        self.tree.delete(*self.tree.get_children())
        routine_id = self.selected_routine_id()
        if not routine_id:
            self.selected_name_var.set("루틴을 선택하세요")
            return
        routine = self.app.config["post_routines"][routine_id]
        self.selected_name_var.set(routine["name"])
        for index, step in enumerate(routine.get("steps", []), 1):
            fallback = step.get("fallback")
            if fallback:
                action, value = "좌표 클릭", f"{fallback[0]}, {fallback[1]}"
            else:
                action, value = "이미지 클릭", step.get("image", "")
            self.tree.insert(
                "",
                "end",
                iid=step["id"],
                values=(
                    index,
                    step["name"],
                    action,
                    value,
                    step.get("timeout", 15),
                    step.get("pre_click_delay", PRE_CLICK_DELAY),
                ),
            )
        if select_step_id and self.tree.exists(select_step_id):
            self.tree.selection_set(select_step_id)
            self.tree.focus(select_step_id)
            self.tree.see(select_step_id)
            self.update_step_details()

    def update_step_details(self, _event: tk.Event | None = None) -> None:
        selected = self.selected_step()
        if not selected:
            self.step_detail_var.set(
                "단계를 선택하면 이미지·좌표와 클릭 설정이 여기에 표시됩니다."
            )
            return
        step, index = selected
        fallback = step.get("fallback")
        target = (
            f"좌표 {fallback[0]}, {fallback[1]}"
            if fallback
            else f"이미지 {step.get('image', '') or '(등록 안 됨)'}"
        )
        self.step_detail_var.set(
            f"{index + 1}번 · {step.get('name', '')}  |  {target}  |  "
            f"제한시간 {float(step.get('timeout', 15.0)):g}초  |  "
            f"클릭 전 대기 {float(step.get('pre_click_delay', PRE_CLICK_DELAY)):g}초  "
            "(더블클릭하면 설정 수정)"
        )
        self.row_name_var.set(step.get("name", ""))
        if fallback is not None:
            self.row_action_var.set("좌표 클릭")
            self.row_value_var.set(f"{fallback[0]}, {fallback[1]}")
        else:
            self.row_action_var.set("이미지 클릭")
            self.row_value_var.set(step.get("image", ""))
        self.row_timeout_var.set(str(step.get("timeout", 15.0)))
        self.row_delay_var.set(
            str(step.get("pre_click_delay", PRE_CLICK_DELAY))
        )

    def choose_row_image(self) -> None:
        path = filedialog.askopenfilename(
            parent=self,
            initialdir=BASE_DIR / "images",
            filetypes=[("이미지", "*.png *.jpg *.bmp")],
        )
        if path:
            self.row_action_var.set("이미지 클릭")
            self.row_value_var.set(path)

    def apply_row_editor(self) -> None:
        selected = self.selected_step()
        if not selected:
            messagebox.showinfo("행 선택", "먼저 수정할 행을 선택하세요.", parent=self)
            return
        step, _index = selected
        try:
            name = self.row_name_var.get().strip()
            if not name:
                raise ValueError("단계 이름은 비워둘 수 없습니다.")
            timeout = float(self.row_timeout_var.get())
            delay = float(self.row_delay_var.get())
            if timeout < 0 or delay < 0:
                raise ValueError("제한시간과 클릭 전 대기는 0 이상이어야 합니다.")
            if self.row_action_var.get() == "좌표 클릭":
                parts = [part.strip() for part in self.row_value_var.get().split(",")]
                if len(parts) != 2:
                    raise ValueError("좌표는 X, Y 형식으로 입력하세요.")
                step["fallback"] = [int(parts[0]), int(parts[1])]
                step["image"] = ""
            else:
                step.pop("fallback", None)
                step["image"] = self.row_value_var.get().strip()
            step["name"] = name
            step["timeout"] = timeout
            step["pre_click_delay"] = delay
        except ValueError as exc:
            messagebox.showerror("입력 오류", str(exc), parent=self)
            return
        self.app.persist()
        self.refresh_steps(select_step_id=step["id"])

    def begin_inline_edit(self, event: tk.Event) -> None:
        """더블클릭한 Treeview 셀 위에 편집기를 올려 행을 직접 수정합니다."""
        item_id = self.tree.identify_row(event.y)
        column_id = self.tree.identify_column(event.x)
        if not item_id or column_id == "#1":
            return
        column_index = int(column_id[1:]) - 1
        columns = ("order", "name", "action", "value", "timeout", "delay")
        field = columns[column_index]
        if field == "order":
            return
        bbox = self.tree.bbox(item_id, column_id)
        if not bbox:
            return
        if self.inline_editor is not None:
            self.inline_editor.destroy()
            self.inline_editor = None

        current_value = str(self.tree.set(item_id, field))
        value_var = tk.StringVar(value=current_value)
        if field == "action":
            editor: tk.Widget = ttk.Combobox(
                self.tree,
                textvariable=value_var,
                values=("이미지 클릭", "좌표 클릭"),
                state="readonly",
            )
        else:
            editor = ttk.Entry(self.tree, textvariable=value_var)
        self.inline_editor = editor
        editor.place(x=bbox[0], y=bbox[1], width=bbox[2], height=bbox[3])
        editor.focus_set()
        if field != "action":
            editor.select_range(0, "end")

        def commit(_event: tk.Event | None = None) -> None:
            if self.inline_editor is not editor:
                return
            if self.apply_inline_value(item_id, field, value_var.get()):
                self.inline_editor = None
                editor.destroy()

        def cancel(_event: tk.Event | None = None) -> None:
            if self.inline_editor is editor:
                self.inline_editor = None
                editor.destroy()

        editor.bind("<Return>", commit)
        editor.bind("<Escape>", cancel)
        editor.bind("<FocusOut>", commit)
        if field == "action":
            editor.bind("<<ComboboxSelected>>", commit)

    def apply_inline_value(self, step_id: str, field: str, value: str) -> bool:
        routine_id = self.selected_routine_id()
        if not routine_id:
            return False
        step = next(
            (
                item
                for item in self.app.config["post_routines"][routine_id]["steps"]
                if item.get("id") == step_id
            ),
            None,
        )
        if step is None:
            return False
        try:
            if field == "name":
                if not value.strip():
                    raise ValueError("단계 이름은 비워둘 수 없습니다.")
                step["name"] = value.strip()
            elif field == "action":
                if value == "좌표 클릭":
                    step["image"] = ""
                    step.setdefault("fallback", [0, 0])
                else:
                    step.pop("fallback", None)
                    step.setdefault("image", "")
            elif field == "value":
                if step.get("fallback") is not None:
                    parts = [part.strip() for part in value.split(",")]
                    if len(parts) != 2:
                        raise ValueError("좌표는 X, Y 형식으로 입력하세요.")
                    step["fallback"] = [int(parts[0]), int(parts[1])]
                else:
                    step["image"] = value.strip()
            elif field == "timeout":
                number = float(value)
                if number < 0:
                    raise ValueError("제한시간은 0 이상이어야 합니다.")
                step["timeout"] = number
            elif field == "delay":
                number = float(value)
                if number < 0:
                    raise ValueError("클릭 전 대기는 0 이상이어야 합니다.")
                step["pre_click_delay"] = number
        except ValueError as exc:
            messagebox.showerror("입력 오류", str(exc), parent=self)
            return False
        self.app.persist()
        self.refresh_steps(select_step_id=step_id)
        return True

    def new_routine(self) -> None:
        name = simpledialog.askstring(
            "기본 전체 루틴으로 새로 만들기",
            "새 루틴 이름:",
            initialvalue="새 전체 자동화 루틴",
            parent=self,
        )
        if not name:
            return
        routine_id = f"routine_{time.time_ns()}"
        default_routine = self.app.config.get("post_routines", {}).get(
            "default_hunting",
            {"steps": []},
        )
        copied_steps = json.loads(json.dumps(default_routine.get("steps", [])))
        self.app.config.setdefault("post_routines", {})[routine_id] = {
            "name": name,
            "steps": copied_steps,
        }
        self.app.persist()
        self.refresh_routines(routine_id)

    def duplicate_routine(self) -> None:
        source_id = self.selected_routine_id()
        if not source_id:
            return
        source = self.app.config["post_routines"][source_id]
        name = simpledialog.askstring(
            "루틴 복제",
            "새 루틴 이름:",
            initialvalue=f"{source['name']} 복사본",
            parent=self,
        )
        if not name:
            return
        routine_id = f"routine_{time.time_ns()}"
        copied_steps = json.loads(json.dumps(source.get("steps", [])))
        self.app.config["post_routines"][routine_id] = {
            "name": name,
            "steps": copied_steps,
        }
        self.app.persist()
        self.refresh_routines(routine_id)

    def rename_routine(self) -> None:
        routine_id = self.selected_routine_id()
        if not routine_id:
            return
        routine = self.app.config["post_routines"][routine_id]
        name = simpledialog.askstring(
            "루틴 이름 변경",
            "새 루틴 이름:",
            initialvalue=routine["name"],
            parent=self,
        )
        if not name:
            return
        routine["name"] = name.strip()
        self.app.persist()
        self.refresh_routines(routine_id)

    def delete_routine(self) -> None:
        routine_id = self.selected_routine_id()
        if not routine_id or routine_id == "default_hunting":
            messagebox.showinfo(
                "삭제 불가",
                "기본 전체 루틴은 삭제할 수 없습니다.",
                parent=self,
            )
            return
        routine = self.app.config["post_routines"][routine_id]
        if not messagebox.askyesno(
            "루틴 삭제",
            f"'{routine['name']}' 루틴을 삭제할까요?",
            parent=self,
        ):
            return
        del self.app.config["post_routines"][routine_id]
        for target in self.app.config.get("targets", {}).values():
            if target.get("post_routine_id") == routine_id:
                target["post_routine_id"] = "default_hunting"
        self.app.persist()
        self.refresh_routines("default_hunting")

    def selected_step(self) -> tuple[dict, int] | None:
        routine_id = self.selected_routine_id()
        selected = self.tree.selection()
        if not routine_id or not selected:
            return None
        steps = self.app.config["post_routines"][routine_id]["steps"]
        for index, step in enumerate(steps):
            if step["id"] == selected[0]:
                return step, index
        return None

    def insert_index_after_selection(self, steps: list[dict]) -> int:
        selected = self.selected_step()
        return selected[1] + 1 if selected else len(steps)

    def add_image_step(self) -> None:
        routine_id = self.selected_routine_id()
        if not routine_id:
            return
        steps = self.app.config["post_routines"][routine_id]["steps"]
        new_step = {
            "id": f"custom_{time.time_ns()}",
            "name": "새 이미지 단계",
            "image": "",
            "timeout": 15.0,
            "pre_click_delay": PRE_CLICK_DELAY,
        }
        steps.insert(self.insert_index_after_selection(steps), new_step)
        self.app.persist()
        self.refresh_steps(select_step_id=new_step["id"])
        self.row_name_entry.focus_set()
        self.row_name_entry.select_range(0, "end")

    def add_coordinate_step(self) -> None:
        routine_id = self.selected_routine_id()
        if not routine_id:
            return
        steps = self.app.config["post_routines"][routine_id]["steps"]
        new_step = {
            "id": f"custom_{time.time_ns()}",
            "name": "새 좌표 단계",
            "image": "",
            "fallback": [0, 0],
            "timeout": 0.1,
            "pre_click_delay": PRE_CLICK_DELAY,
        }
        steps.insert(self.insert_index_after_selection(steps), new_step)
        self.app.persist()
        self.refresh_steps(select_step_id=new_step["id"])
        self.row_name_entry.focus_set()
        self.row_name_entry.select_range(0, "end")

    def change_step_image(self) -> None:
        selected = self.selected_step()
        if not selected:
            return
        step, _index = selected
        path = filedialog.askopenfilename(
            parent=self,
            initialdir=BASE_DIR / "images",
            filetypes=[("이미지", "*.png *.jpg *.bmp")],
        )
        if path:
            step["image"] = path
            step.pop("fallback", None)
            self.app.persist()
            self.refresh_steps(select_step_id=step["id"])

    def edit_step_settings(self) -> None:
        selected = self.selected_step()
        if not selected:
            messagebox.showinfo("행 선택", "먼저 수정할 행을 선택하세요.", parent=self)
            return
        self.update_step_details()
        self.row_name_entry.focus_set()
        self.row_name_entry.select_range(0, "end")

    def delete_step(self) -> None:
        routine_id = self.selected_routine_id()
        selected = self.selected_step()
        if not routine_id or not selected:
            return
        _step, index = selected
        del self.app.config["post_routines"][routine_id]["steps"][index]
        self.app.persist()
        self.refresh_steps()

    def move_step(self, offset: int) -> None:
        routine_id = self.selected_routine_id()
        selected = self.selected_step()
        if not routine_id or not selected:
            return
        _step, index = selected
        steps = self.app.config["post_routines"][routine_id]["steps"]
        destination = max(0, min(len(steps) - 1, index + offset))
        if destination == index:
            return
        steps.insert(destination, steps.pop(index))
        self.app.persist()
        self.refresh_steps(select_step_id=steps[destination]["id"])

    def capture_image(
        self,
        variable: tk.StringVar,
        step: dict,
    ) -> None:
        key = self.source_label_to_key.get(self.capture_source_var.get())
        if not key:
            messagebox.showerror(
                "캡처 대상 없음",
                "상단에서 캡처할 모니터/분면을 선택하세요.",
                parent=self,
            )
            return
        path = self.app.capture_and_crop(key, step["id"])
        if path:
            variable.set(path)

    def save(self) -> None:
        grouped_steps = {
            "pre_death_steps": [],
            "entry_steps": [],
            "steps": [],
        }
        try:
            for row in self.rows:
                timeout = float(row["timeout"].get())
                delay = float(row["delay"].get())
                if timeout < 0 or delay < 0:
                    raise ValueError
                step = dict(row["step"])
                step["image"] = row["image"].get().strip()
                step["timeout"] = timeout
                step["pre_click_delay"] = delay
                grouped_steps[row["group"]].append(step)
        except ValueError:
            messagebox.showerror(
                "입력 오류",
                "검색 제한시간과 클릭 전 대기에는 0 이상의 숫자를 입력하세요.",
                parent=self,
            )
            return
        for group, steps in grouped_steps.items():
            self.app.config[group] = steps
        self.app.persist()
        self.destroy()


class EditableRoutineManager(tk.Toplevel):
    """분면별 설정창과 같은 셀 입력 방식으로 전체 루틴을 편집합니다."""

    def __init__(
        self,
        app: "MacroManager",
        initial_capture_key: str | None = None,
        initial_routine_id: str | None = None,
    ) -> None:
        super().__init__(app.root)
        self.app = app
        self.title("전체 자동화 루틴 만들기·편집")
        self.transient(app.root)
        self.minsize(1700, 930)
        center_on_parent(self, app.root, 2050, 1050)
        self.routine_ids: list[str] = []
        self.current_routine_id: str | None = None
        self.rows: list[dict] = []
        # 저장 버튼을 누르기 전까지 실제 실행 설정과 분리된 사본만 수정합니다.
        self.working_routines = json.loads(
            json.dumps(app.config.get("post_routines", {}))
        )

        guide = ttk.Label(
            self,
            text=(
                "기본 전체 루틴을 선택한 뒤 각 행의 셀을 직접 수정하세요. "
                "새 루틴은 기본 전체 루틴을 복사해서 만듭니다.\n"
                "· 이미지 클릭: 등록한 이미지를 화면에서 찾아 발견된 이미지의 중앙을 클릭합니다.\n"
                "· 좌표 클릭: 이미지를 검색하지 않고 해당 모니터/분면 기준 X,Y 위치를 바로 클릭합니다."
            ),
            font=("Malgun Gothic", 11, "bold"),
            padding=(12, 10),
            justify="left",
        )
        guide.pack(fill="x")

        content = ttk.Frame(self)
        content.pack(fill="both", expand=True)
        left = ttk.Frame(content, padding=10)
        left.pack(side="left", fill="y")
        ttk.Label(left, text="전체 루틴", font=("Malgun Gothic", 11, "bold")).pack()
        routine_buttons = ttk.Frame(left)
        routine_buttons.pack(fill="x", pady=6)
        for text, command in (
            ("기본 전체 루틴으로 새로 만들기", self.new_routine),
            ("선택 루틴 복제", self.duplicate_routine),
            ("선택 루틴 이름 변경", self.rename_routine),
            ("선택 루틴 삭제", self.delete_routine),
        ):
            ttk.Button(
                routine_buttons,
                text=text,
                command=command,
                width=28,
            ).pack(pady=3)
        self.routine_list = tk.Listbox(
            left,
            width=30,
            height=24,
            exportselection=False,
        )
        self.routine_list.pack(fill="both", expand=True, pady=(4, 0))
        self.routine_list.bind("<<ListboxSelect>>", self.change_routine)

        right = ttk.Frame(content, padding=(4, 10, 10, 10))
        right.pack(side="left", fill="both", expand=True)
        capture_bar = ttk.Frame(right)
        capture_bar.pack(fill="x", pady=(0, 6))
        ttk.Label(capture_bar, text="캡처할 화면:").pack(side="left")
        self.capture_label_to_key = {
            label: key for key, (label, _rect) in self.app.targets.items()
        }
        initial_capture_label = next(
            (
                label
                for label, key in self.capture_label_to_key.items()
                if key == initial_capture_key
            ),
            next(iter(self.capture_label_to_key), ""),
        )
        self.capture_source_var = tk.StringVar(
            value=initial_capture_label
        )
        ttk.Combobox(
            capture_bar,
            textvariable=self.capture_source_var,
            values=list(self.capture_label_to_key),
            state="readonly",
            width=24,
        ).pack(side="left", padx=6)
        ttk.Label(
            capture_bar,
            text="각 행의 캡처 버튼은 이 모니터/분면 화면을 사용합니다.",
        ).pack(side="left", padx=6)
        self.routine_title_var = tk.StringVar()
        ttk.Label(
            right,
            textvariable=self.routine_title_var,
            font=("Malgun Gothic", 13, "bold"),
        ).pack(anchor="w", pady=(0, 6))
        outer = ttk.Frame(right)
        outer.pack(fill="both", expand=True)
        self.canvas = tk.Canvas(outer, highlightthickness=0)
        scrollbar = ttk.Scrollbar(outer, orient="vertical", command=self.canvas.yview)
        self.body = ttk.Frame(self.canvas)
        self.body.bind(
            "<Configure>",
            lambda _event: self.canvas.configure(scrollregion=self.canvas.bbox("all")),
        )
        self.canvas.create_window((0, 0), window=self.body, anchor="nw")
        self.canvas.configure(yscrollcommand=scrollbar.set)
        self.canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
        footer = ttk.Frame(right)
        footer.pack(fill="x", pady=8)
        ttk.Button(footer, text="변경 내용 저장", command=self.save_rows, width=20).pack(side="left")
        ttk.Button(footer, text="닫기", command=self.close, width=16).pack(side="right")
        self.protocol("WM_DELETE_WINDOW", self.close)
        self.refresh_routine_list(
            initial_routine_id or "default_hunting"
        )

    def selected_list_id(self) -> str | None:
        selected = self.routine_list.curselection()
        if not selected:
            return None
        return self.routine_ids[selected[0]]

    def refresh_routine_list(self, select_id: str | None = None) -> None:
        self.routine_list.delete(0, "end")
        self.routine_ids = []
        for routine_id, routine in self.working_routines.items():
            self.routine_ids.append(routine_id)
            prefix = "[기본 템플릿] " if routine_id == "default_hunting" else ""
            self.routine_list.insert("end", prefix + routine.get("name", routine_id))
        if self.routine_ids:
            target_id = select_id if select_id in self.routine_ids else self.routine_ids[0]
            index = self.routine_ids.index(target_id)
            self.routine_list.selection_set(index)
            self.routine_list.activate(index)
            self.current_routine_id = target_id
            self.build_rows()

    def change_routine(self, _event: tk.Event | None = None) -> None:
        new_id = self.selected_list_id()
        if not new_id or new_id == self.current_routine_id:
            return
        if self.current_routine_id:
            if not self.save_rows(show_message=False):
                return
        self.current_routine_id = new_id
        self.build_rows()

    def build_rows(self, focus_step_id: str | None = None) -> None:
        for child in self.body.winfo_children():
            child.destroy()
        self.rows = []
        routine = self.working_routines.get(self.current_routine_id or "", {})
        self.routine_title_var.set(routine.get("name", ""))
        headers = (
            "순서", "단계 이름", "동작", "공용 이미지 또는 좌표 X,Y",
            "제한시간", "클릭 전 대기", "행 작업",
        )
        for column, title in enumerate(headers):
            ttk.Label(self.body, text=title, font=("Malgun Gothic", 10, "bold")).grid(
                row=0, column=column, padx=3, pady=6
            )
        self.body.columnconfigure(1, weight=2)
        self.body.columnconfigure(3, weight=5)
        for index, step in enumerate(routine.get("steps", [])):
            fallback = step.get("fallback")
            target_coordinate = bool(step.get("coordinate_from_target"))
            name_var = tk.StringVar(value=step.get("name", ""))
            action_var = tk.StringVar(
                value="좌표 클릭"
                if fallback is not None or target_coordinate
                else "이미지 클릭"
            )
            value_var = tk.StringVar(value=step.get("image", ""))
            x_var = tk.StringVar(
                value=str(fallback[0]) if fallback is not None else ""
            )
            y_var = tk.StringVar(
                value=str(fallback[1]) if fallback is not None else ""
            )
            timeout_var = tk.StringVar(value=str(step.get("timeout", 15.0)))
            delay_var = tk.StringVar(value=str(step.get("pre_click_delay", PRE_CLICK_DELAY)))
            ttk.Label(self.body, text=str(index + 1), width=5, anchor="center").grid(row=index + 1, column=0)
            name_entry = ttk.Entry(self.body, textvariable=name_var, width=28)
            name_entry.grid(row=index + 1, column=1, sticky="ew", padx=3, pady=2)
            action_combo = ttk.Combobox(
                self.body,
                textvariable=action_var,
                values=("이미지 클릭", "좌표 클릭"),
                state="readonly",
                width=12,
            )
            action_combo.grid(row=index + 1, column=2, padx=3, pady=2)
            value_cell = ttk.Frame(self.body)
            value_cell.grid(row=index + 1, column=3, sticky="ew", padx=3, pady=2)
            image_entry = ttk.Entry(value_cell, textvariable=value_var, width=58)
            image_entry.bind(
                "<Button-1>",
                lambda event, v=value_var, a=action_var: self.click_image_entry(
                    event, v, a
                ),
            )
            coordinate_frame = ttk.Frame(value_cell)
            ttk.Label(coordinate_frame, text="X").pack(side="left", padx=(0, 3))
            ttk.Entry(coordinate_frame, textvariable=x_var, width=14).pack(side="left")
            ttk.Label(coordinate_frame, text="Y").pack(side="left", padx=(12, 3))
            ttk.Entry(coordinate_frame, textvariable=y_var, width=14).pack(side="left")
            button_refs: dict[str, ttk.Button] = {}

            def toggle_value_cell(
                *_args: object,
                action: tk.StringVar = action_var,
                image_widget: ttk.Entry = image_entry,
                coordinate_widget: ttk.Frame = coordinate_frame,
                buttons: dict[str, ttk.Button] = button_refs,
            ) -> None:
                image_widget.pack_forget()
                coordinate_widget.pack_forget()
                if action.get() == "좌표 클릭":
                    coordinate_widget.pack(fill="x")
                    buttons["file"].configure(state="disabled")
                    buttons["capture"].configure(state="disabled")
                else:
                    image_widget.pack(fill="x")
                    buttons["file"].configure(state="normal")
                    buttons["capture"].configure(state="normal")
            ttk.Entry(self.body, textvariable=timeout_var, width=9).grid(row=index + 1, column=4, padx=3)
            ttk.Entry(self.body, textvariable=delay_var, width=9).grid(row=index + 1, column=5, padx=3)
            actions = ttk.Frame(self.body)
            actions.grid(row=index + 1, column=6, padx=2)
            file_button = ttk.Button(actions, text="파일", width=5, command=lambda v=value_var, a=action_var: self.choose_file(v, a))
            file_button.pack(side="left")
            capture_button = ttk.Button(
                actions,
                text="캡처",
                width=5,
                command=lambda v=value_var, a=action_var, sid=step.get("id", "step"), order=index + 1, n=name_var: self.capture_row(v, a, sid, order, n),
            )
            capture_button.pack(side="left")
            button_refs["file"] = file_button
            button_refs["capture"] = capture_button
            ttk.Button(actions, text="아래+", width=6, command=lambda i=index: self.add_below(i)).pack(side="left")
            ttk.Button(actions, text="삭제", width=5, command=lambda i=index: self.delete_row(i)).pack(side="left")
            ttk.Button(actions, text="↑", width=3, command=lambda i=index: self.move_row(i, -1)).pack(side="left")
            ttk.Button(actions, text="↓", width=3, command=lambda i=index: self.move_row(i, 1)).pack(side="left")
            action_var.trace_add("write", toggle_value_cell)
            toggle_value_cell()
            self.rows.append({
                "step": step, "name": name_var, "action": action_var,
                "value": value_var, "x": x_var, "y": y_var,
                "from_target": target_coordinate,
                "timeout": timeout_var, "delay": delay_var,
            })
            if focus_step_id == step.get("id"):
                self.after(10, name_entry.focus_set)

    def choose_file(self, value_var: tk.StringVar, action_var: tk.StringVar) -> None:
        path = filedialog.askopenfilename(parent=self, initialdir=BASE_DIR / "images", filetypes=[("이미지", "*.png *.jpg *.bmp")])
        if path:
            action_var.set("이미지 클릭")
            value_var.set(path)

    def click_image_entry(
        self,
        _event: tk.Event,
        value_var: tk.StringVar,
        action_var: tk.StringVar,
    ) -> str:
        self.choose_file(value_var, action_var)
        return "break"

    def capture_row(
        self,
        value_var: tk.StringVar,
        action_var: tk.StringVar,
        step_id: str,
        order: int,
        name_var: tk.StringVar,
    ) -> None:
        key = self.capture_label_to_key.get(self.capture_source_var.get())
        if not key:
            messagebox.showerror("캡처 화면 없음", "캡처할 모니터/분면을 선택하세요.", parent=self)
            return
        routine_dir = CAPTURE_DIR / "common_routines" / (
            self.current_routine_id or "default_hunting"
        )
        path = self.app.capture_and_crop(
            key,
            step_id,
            destination_dir=routine_dir,
            parent=self,
            suggested_filename=self.capture_filename(order, name_var.get()),
        )
        if path:
            action_var.set("이미지 클릭")
            value_var.set(path)

    @staticmethod
    def capture_filename(order: int, step_name: str) -> str:
        clean_name = re.sub(r'[<>:"/\\|?*]', "", step_name.strip())
        clean_name = re.sub(r"\s+", "_", clean_name).strip("._")
        if not clean_name:
            clean_name = f"{order:02d}_step"
        elif not re.match(r"^\d+", clean_name):
            clean_name = f"{order:02d}_{clean_name}"
        return f"{clean_name}.png"

    def save_rows(self, show_message: bool = True) -> bool:
        if not self.current_routine_id:
            return True
        try:
            for row in self.rows:
                step = row["step"]
                name = row["name"].get().strip()
                if not name:
                    raise ValueError("단계 이름은 비워둘 수 없습니다.")
                timeout = float(row["timeout"].get())
                delay = float(row["delay"].get())
                if timeout < 0 or delay < 0:
                    raise ValueError("제한시간과 클릭 전 대기는 0 이상이어야 합니다.")
                step["name"], step["timeout"], step["pre_click_delay"] = name, timeout, delay
                if row["action"].get() == "좌표 클릭":
                    x_text = row["x"].get().strip()
                    y_text = row["y"].get().strip()
                    if not x_text and not y_text and row.get("from_target"):
                        step.pop("fallback", None)
                        step["coordinate_from_target"] = True
                    else:
                        if not x_text or not y_text:
                            raise ValueError(f"'{name}'의 X와 Y 좌표를 모두 입력하세요.")
                        step["fallback"] = [int(x_text), int(y_text)]
                        step.pop("coordinate_from_target", None)
                    step["image"] = ""
                else:
                    step.pop("fallback", None)
                    step.pop("coordinate_from_target", None)
                    step["image"] = row["value"].get().strip()
        except ValueError as exc:
            messagebox.showerror("입력 오류", str(exc), parent=self)
            return False
        if show_message:
            self.app.config["post_routines"] = json.loads(
                json.dumps(self.working_routines)
            )
            initialize_routine_target_settings(self.app.config)
            existing_ids = set(self.working_routines)
            for target in self.app.config.get("targets", {}).values():
                if target.get("post_routine_id") not in existing_ids:
                    target["post_routine_id"] = "default_hunting"
            self.app.persist()
            self.routine_title_var.set(
                self.working_routines[self.current_routine_id]["name"]
                + " — 저장 완료"
            )
        return True

    def add_below(self, index: int) -> None:
        if not self.save_rows(show_message=False):
            return
        steps = self.working_routines[self.current_routine_id]["steps"]
        step = {"id": f"custom_{time.time_ns()}", "name": "새 단계", "image": "", "timeout": 15.0, "pre_click_delay": PRE_CLICK_DELAY}
        steps.insert(index + 1, step)
        self.build_rows(step["id"])

    def delete_row(self, index: int) -> None:
        if not self.save_rows(show_message=False):
            return
        del self.working_routines[self.current_routine_id]["steps"][index]
        self.build_rows()

    def move_row(self, index: int, offset: int) -> None:
        if not self.save_rows(show_message=False):
            return
        steps = self.working_routines[self.current_routine_id]["steps"]
        destination = max(0, min(len(steps) - 1, index + offset))
        if destination != index:
            step = steps.pop(index)
            steps.insert(destination, step)
            self.build_rows(step.get("id"))

    def new_routine(self) -> None:
        if self.current_routine_id and not self.save_rows(show_message=False):
            return
        name = simpledialog.askstring("새 전체 루틴", "새 루틴 이름:", initialvalue="새 전체 자동화 루틴", parent=self)
        if not name:
            return
        routine_id = f"routine_{time.time_ns()}"
        source = self.working_routines.get("default_hunting", {"steps": []})
        self.working_routines[routine_id] = {"name": name, "steps": json.loads(json.dumps(source.get("steps", [])))}
        self.refresh_routine_list(routine_id)

    def duplicate_routine(self) -> None:
        if self.current_routine_id and not self.save_rows(show_message=False):
            return
        source_id = self.selected_list_id()
        if not source_id:
            return
        source = self.working_routines[source_id]
        name = simpledialog.askstring("루틴 복제", "새 루틴 이름:", initialvalue=f"{source['name']} 복사본", parent=self)
        if not name:
            return
        routine_id = f"routine_{time.time_ns()}"
        self.working_routines[routine_id] = {"name": name, "steps": json.loads(json.dumps(source.get("steps", [])))}
        self.refresh_routine_list(routine_id)

    def rename_routine(self) -> None:
        if self.current_routine_id and not self.save_rows(show_message=False):
            return
        routine_id = self.selected_list_id()
        if not routine_id:
            return
        routine = self.working_routines[routine_id]
        name = simpledialog.askstring("루틴 이름 변경", "새 루틴 이름:", initialvalue=routine["name"], parent=self)
        if name:
            routine["name"] = name.strip()
            self.refresh_routine_list(routine_id)

    def delete_routine(self) -> None:
        if self.current_routine_id and not self.save_rows(show_message=False):
            return
        routine_id = self.selected_list_id() or self.current_routine_id
        if not routine_id or routine_id == "default_hunting":
            messagebox.showinfo("삭제 불가", "기본 전체 루틴은 삭제할 수 없습니다.", parent=self)
            return
        routine_name = self.working_routines[routine_id].get("name", routine_id)
        if not messagebox.askyesno(
            "루틴 삭제",
            f"'{routine_name}' 루틴을 삭제할까요?\n\n"
            "목록에서 삭제한 뒤 '변경 내용 저장'을 눌러야 최종 반영됩니다.",
            parent=self,
        ):
            return
        del self.working_routines[routine_id]
        self.current_routine_id = None
        self.refresh_routine_list("default_hunting")
        self.routine_title_var.set(
            f"{routine_name} 삭제 예정 — 변경 내용 저장을 눌러 최종 반영"
        )

    def close(self) -> None:
        self.destroy()


class MacroManager:
    COPY_HOTKEY = 1
    CLICK_HOTKEY = 2

    def __init__(self) -> None:
        self.root = tk.Tk()
        self.root.title("범용 이미지 매크로 관리자")
        self.root.minsize(1300, 820)
        center_on_cursor_monitor(self.root, 1500, 900)
        self.config = load_config()
        self.config_lock = threading.Lock()
        self.targets = monitor_quadrants()
        self.status_vars: dict[str, tk.StringVar] = {}
        self.enabled_vars: dict[str, tk.BooleanVar] = {}
        self.routine_vars: dict[str, tk.StringVar] = {}
        self.routine_combos: dict[str, ttk.Combobox] = {}
        self.hotkey_thread_id: int | None = None
        self.engine = MacroEngine(self)
        self.global_status = tk.StringVar(value="준비")
        self.build_ui()
        self.root.protocol("WM_DELETE_WINDOW", self.close)
        self.start_hotkeys()
        # 창과 전역 단축키 초기화가 끝나면 기본적으로 감시를 시작합니다.
        self.root.after(300, self.start)

    def build_ui(self) -> None:
        top = ttk.Frame(self.root, padding=10)
        top.pack(fill="x")
        ttk.Button(top, text="감시 시작", command=self.start).pack(side="left", padx=3)
        ttk.Button(top, text="감시 중지", command=self.stop).pack(side="left", padx=3)
        ttk.Button(top, text="공용 진입 이미지", command=lambda: CommonRoutineEditor(self)).pack(side="left", padx=12)
        ttk.Button(
            top,
            text="전체 루틴 관리",
            command=self.open_routine_manager,
        ).pack(side="left", padx=3)
        ttk.Label(top, text="인식 기준").pack(side="left")
        self.threshold_var = tk.StringVar(value=str(self.config.get("threshold", DEFAULT_THRESHOLD)))
        ttk.Entry(top, textvariable=self.threshold_var, width=7).pack(side="left", padx=3)
        ttk.Label(top, text="귀환 후 대기(초)").pack(side="left", padx=(12, 0))
        self.return_wait_var = tk.StringVar(
            value=str(self.config.get("return_wait_seconds", 20))
        )
        ttk.Entry(
            top,
            textvariable=self.return_wait_var,
            width=7,
        ).pack(side="left", padx=3)
        ttk.Button(top, text="설정 저장", command=self.save_threshold).pack(side="left")
        ttk.Label(top, text="F5 테스트 클릭 / Ctrl+Shift+C 좌표 복사").pack(side="right")
        ttk.Label(self.root, textvariable=self.global_status, relief="groove", padding=8).pack(fill="x", padx=10)

        container = ttk.Frame(self.root, padding=10)
        container.pack(fill="both", expand=True)
        headers = ("사용", "대상", "상태", "선택 루틴", "루틴 이미지·좌표", "현재 위치 테스트")
        for col, text in enumerate(headers):
            ttk.Label(container, text=text, font=("Malgun Gothic", 10, "bold")).grid(row=0, column=col, padx=5, pady=5)
        container.columnconfigure(2, weight=0)
        container.columnconfigure(3, weight=1)
        for row, (key, (label, _rect)) in enumerate(self.targets.items(), 1):
            target = self.config["targets"].setdefault(key, {"enabled": False, "overrides": {}, "fallbacks": {}})
            enabled = tk.BooleanVar(value=bool(target.get("enabled", False)))
            status = tk.StringVar(value="대기")
            self.enabled_vars[key], self.status_vars[key] = enabled, status
            ttk.Checkbutton(container, variable=enabled, command=lambda k=key: self.toggle_target(k)).grid(row=row, column=0)
            target_label = ttk.Label(
                container,
                text=label,
                width=23,
                cursor="hand2",
            )
            target_label.grid(
                row=row,
                column=1,
                sticky="w",
                padx=5,
                pady=4,
            )
            target_label.bind(
                "<Button-1>",
                lambda _event, target_key=key: TargetEditor(
                    self,
                    target_key,
                ),
            )
            ttk.Label(
                container,
                textvariable=status,
                relief="sunken",
                width=32,
            ).grid(row=row, column=2, sticky="ew", padx=5)
            routine_id = target.get("post_routine_id", "default_hunting")
            routine = self.config.get("post_routines", {}).get(routine_id, {})
            routine_var = tk.StringVar(value=routine.get("name", "기본 전체 루틴"))
            routine_combo = ttk.Combobox(
                container,
                textvariable=routine_var,
                values=self.routine_names(),
                state="readonly",
                width=24,
            )
            routine_combo.grid(row=row, column=3, sticky="ew", padx=5)
            routine_combo.bind(
                "<<ComboboxSelected>>",
                lambda _event, target_key=key: self.change_target_routine(target_key),
            )
            self.routine_vars[key] = routine_var
            self.routine_combos[key] = routine_combo
            ttk.Button(container, text="분면 루틴 설정", command=lambda k=key: TargetEditor(self, k)).grid(row=row, column=4, padx=5)
            ttk.Button(container, text="분면 중앙 클릭", command=lambda k=key: self.test_target(k)).grid(row=row, column=5, padx=5)

    def routine_names(self) -> list[str]:
        return [
            routine.get("name", routine_id)
            for routine_id, routine in self.config.get("post_routines", {}).items()
        ]

    def change_target_routine(self, key: str) -> None:
        selected_name = self.routine_vars[key].get()
        routine_id = next(
            (
                rid
                for rid, routine in self.config.get("post_routines", {}).items()
                if routine.get("name", rid) == selected_name
            ),
            None,
        )
        if not routine_id:
            return
        self.config["targets"].setdefault(key, {})["post_routine_id"] = routine_id
        self.persist()
        self.engine.reset_target(key)
        self.status_vars[key].set(f"루틴 변경: {selected_name} → 첫 단계 대기")

    def refresh_main_routine_choices(self) -> None:
        names = self.routine_names()
        for key, combo in self.routine_combos.items():
            combo.configure(values=names)
            target = self.config.get("targets", {}).get(key, {})
            routine_id = target.get("post_routine_id", "default_hunting")
            routine = self.config.get("post_routines", {}).get(routine_id)
            if routine is None and self.config.get("post_routines"):
                routine_id, routine = next(iter(self.config["post_routines"].items()))
                target["post_routine_id"] = routine_id
            self.routine_vars[key].set(
                (routine or {}).get("name", "")
            )

    def open_routine_manager(self) -> None:
        manager = EditableRoutineManager(self)
        self.root.wait_window(manager)
        self.refresh_main_routine_choices()

    def config_snapshot(self) -> dict:
        with self.config_lock:
            return json.loads(json.dumps(self.config))

    def persist(self) -> None:
        with self.config_lock:
            save_config(self.config)
        self.global_status.set(f"설정 저장 완료: {CONFIG_FILE.name}")

    def save_threshold(self) -> None:
        try:
            value = float(self.threshold_var.get())
            if not 0 < value <= 1:
                raise ValueError
            return_wait = float(self.return_wait_var.get())
            if return_wait < 0:
                raise ValueError
            self.config["threshold"] = value
            self.config["return_wait_seconds"] = return_wait
            self.persist()
        except ValueError:
            messagebox.showerror(
                "입력 오류",
                "인식 기준은 0 초과 1 이하, 귀환 대기는 0 이상의 숫자여야 합니다.",
            )

    def toggle_target(self, key: str) -> None:
        self.config["targets"].setdefault(key, {})["enabled"] = self.enabled_vars[key].get()
        self.persist()

    def start(self) -> None:
        self.engine.start()
        self.global_status.set("감시 중")

    def stop(self) -> None:
        self.engine.stop()
        self.global_status.set("감시 중지")

    def set_row_status(self, key: str, text: str) -> None:
        self.root.after(0, self.status_vars[key].set, text)

    def set_global_status(self, text: str) -> None:
        self.root.after(0, self.global_status.set, text)

    def test_target(self, key: str) -> None:
        rect = self.targets[key][1]
        threading.Thread(target=held_left_click, args=(rect.left + rect.width // 2, rect.top + rect.height // 2), daemon=True).start()

    def capture_and_crop(
        self,
        key: str,
        step_id: str,
        destination_dir: Path | None = None,
        parent: tk.Misc | None = None,
        suggested_filename: str | None = None,
    ) -> str | None:
        rect = self.targets[key][1]
        dialog_parent = parent or self.root
        try:
            with mss.MSS() as capture:
                frame = np.asarray(capture.grab(rect.as_mss()))
            bgr = cv2.cvtColor(frame, cv2.COLOR_BGRA2BGR)
            editor = CropDialog(dialog_parent, bgr)
            dialog_parent.wait_window(editor)
            if editor.result is None:
                return None
            x, y, width, height = editor.result
            if width <= 0 or height <= 0:
                return None
            cropped = bgr[y:y + height, x:x + width]
            monitor_number, quadrant_number = key[1:].split("q", 1)
            target_capture_dir = destination_dir or (
                CAPTURE_DIR
                / f"monitor_{monitor_number}"
                / f"quadrant_{quadrant_number}"
            )
            target_capture_dir.mkdir(parents=True, exist_ok=True)
            suggested = suggested_filename or f"{step_id}.png"
            path = filedialog.asksaveasfilename(
                parent=dialog_parent,
                initialdir=target_capture_dir,
                initialfile=suggested,
                defaultextension=".png",
                filetypes=[("PNG 이미지", "*.png")],
            )
            if not path:
                return None
            success, encoded = cv2.imencode(".png", cropped)
            if not success:
                raise RuntimeError("PNG 인코딩 실패")
            encoded.tofile(path)
            return path
        except Exception as exc:
            logging.exception("화면 캡처 실패")
            messagebox.showerror("캡처 실패", str(exc), parent=dialog_parent)
            return None

    def coordinate_text(self) -> str:
        x, y = cursor_position()
        for _key, (label, rect) in self.targets.items():
            if rect.left <= x < rect.right and rect.top <= y < rect.bottom:
                return f"{label}: {x - rect.left}, {y - rect.top} | 화면: {x}, {y}"
        return f"화면: {x}, {y} (등록된 모니터 범위 밖)"

    def copy_coordinate(self) -> None:
        try:
            text = self.coordinate_text()
            self.root.clipboard_clear()
            self.root.clipboard_append(text)
            self.global_status.set(f"좌표 복사: {text}")
        except Exception as exc:
            self.global_status.set(f"좌표 취득 실패: {exc}")

    def start_hotkeys(self) -> None:
        threading.Thread(target=self.hotkey_loop, daemon=True).start()

    def hotkey_loop(self) -> None:
        user32 = ctypes.windll.user32
        self.hotkey_thread_id = int(ctypes.windll.kernel32.GetCurrentThreadId())
        copy_ok = user32.RegisterHotKey(None, self.COPY_HOTKEY, 0x0002 | 0x0004 | 0x4000, ord("C"))
        click_ok = user32.RegisterHotKey(None, self.CLICK_HOTKEY, 0x4000, 0x74)
        if not copy_ok or not click_ok:
            self.set_global_status("전역 단축키 등록 실패: 다른 프로그램에서 사용 중인지 확인")
        message = wintypes.MSG()
        try:
            while user32.GetMessageW(ctypes.byref(message), None, 0, 0) > 0:
                if message.message == 0x0312:
                    if message.wParam == self.COPY_HOTKEY:
                        self.root.after(0, self.copy_coordinate)
                    elif message.wParam == self.CLICK_HOTKEY:
                        try:
                            coordinate = self.coordinate_text()
                            held_left_click()
                            self.set_global_status(
                                f"F5 테스트 클릭: {coordinate} (80ms)"
                            )
                        except Exception as exc:
                            self.set_global_status(f"F5 클릭 실패: {exc}")
        finally:
            user32.UnregisterHotKey(None, self.COPY_HOTKEY)
            user32.UnregisterHotKey(None, self.CLICK_HOTKEY)

    def close(self) -> None:
        self.engine.stop()
        if self.hotkey_thread_id:
            ctypes.windll.user32.PostThreadMessageW(self.hotkey_thread_id, 0x0012, 0, 0)
        self.root.destroy()

    def run(self) -> None:
        self.root.mainloop()


def main() -> None:
    enable_dpi_awareness()
    logging.basicConfig(
        filename=LOG_FILE,
        level=logging.INFO,
        encoding="utf-8",
        format="%(asctime)s | %(levelname)s | %(message)s",
    )
    MacroManager().run()


if __name__ == "__main__":
    try:
        if instance_is_running():
            show_already_running()
        elif ensure_admin():
            hide_console()
            if not acquire_single_instance():
                show_already_running()
            else:
                try:
                    main()
                finally:
                    release_single_instance()
    except Exception as error:
        logging.exception("프로그램 오류: %s", error)
